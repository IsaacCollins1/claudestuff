          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">TutorialUI</string>
              <string name="Source"><![CDATA[--!strict
-- The first-time tutorial card: "STEP 1 OF 4 — GRAB A BOX!". Steps are
-- completed by the server; this shows them, celebrates each one with coins
-- and confetti, and points at the UPGRADE button for the last step.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Tutorial = require(Shared:WaitForChild("Tutorial"))

local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)
local Notifications = require(script.Parent.Notifications)
local SoundPlayer = require(script.Parent.SoundPlayer)
local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Window = require(script.Parent.Window)

local Colors = UIKit.Colors

local TutorialUI = {}

local screen: ScreenGui
local card: Frame
local cardStroke: UIStroke
local iconLabel: TextLabel
local stepLabel: TextLabel
local titleLabel: TextLabel
local textLabel: TextLabel
local segments: { Frame } = {}
local pointer: TextLabel
local shownStep: number? = nil
local celebrating = false
local cardWanted = false -- the card hides while a menu is open

local CARD_POSITION = UDim2.new(0.5, 0, 0, 68)

local function isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function build()
	card = UIKit.new("Frame", {
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = CARD_POSITION,
		Size = UDim2.fromOffset(500, 124),
		BackgroundColor3 = Colors.Panel,
		Visible = false,
		ZIndex = 40,
	}, screen)
	UIKit.corner(card, UDim.new(0, 22))
	cardStroke = UIKit.stroke(card, Colors.Yellow, 4)
	UIKit.gradient(card, Color3.fromRGB(255, 255, 255), Color3.fromRGB(185, 190, 215))

	local iconCircle = UIKit.new("Frame", {
		Size = UDim2.fromOffset(88, 88),
		Position = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Colors.Yellow,
		ZIndex = 41,
	}, card)
	UIKit.corner(iconCircle, UDim.new(1, 0))
	UIKit.stroke(iconCircle, Colors.Outline, 3)
	UIKit.gradient(iconCircle, Color3.fromRGB(255, 255, 255), Color3.fromRGB(215, 200, 170))
	iconLabel = UIKit.label(iconCircle, "📦", { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.15, 0.15), ZIndex = 42 })
	UIKit.wobble(iconLabel, 8)

	stepLabel = UIKit.title(card, "STEP 1 OF 4", {
		Size = UDim2.fromOffset(200, 20),
		Position = UDim2.fromOffset(116, 10),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Yellow,
		ZIndex = 41,
	}, Colors.Outline, 2)
	titleLabel = UIKit.title(card, "", {
		Size = UDim2.new(1, -206, 0, 34), -- leaves room for the SKIP button
		Position = UDim2.fromOffset(116, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 41,
	}, Colors.Outline, 3)
	textLabel = UIKit.label(card, "", {
		Size = UDim2.new(1, -130, 0, 26),
		Position = UDim2.fromOffset(116, 66),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(230, 235, 255),
		ZIndex = 41,
	})
	UIKit.textStroke(textLabel, Colors.Outline, 1.5)

	local bar = UIKit.new("Frame", {
		Size = UDim2.new(1, -130, 0, 10),
		Position = UDim2.fromOffset(116, 100),
		BackgroundTransparency = 1,
		ZIndex = 41,
	}, card)
	UIKit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, bar)
	for index = 1, #Tutorial.Steps do
		local segment = UIKit.new("Frame", {
			Size = UDim2.new(1 / #Tutorial.Steps, -6, 1, 0),
			BackgroundColor3 = Colors.Dark,
			LayoutOrder = index,
			ZIndex = 42,
		}, bar)
		UIKit.corner(segment, UDim.new(1, 0))
		UIKit.stroke(segment, Colors.Outline, 1.5)
		segments[index] = segment
	end

	local skip = UIKit.chunky(card, {
		Name = "Skip",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(74, 30),
		Color = Colors.GreyDark,
		Text = "SKIP",
		Depth = 4,
		ZIndex = 43,
		Radius = UDim.new(0, 10),
	}, function()
		SoundPlayer.play("Click")
		Remotes.event("SkipTutorial"):FireServer()
		cardWanted = false
	end)
	skip.Button.Name = "Skip"

	-- Bouncing hand pointing at the UPGRADE button during the last step.
	pointer = UIKit.title(screen, "👈 CLICK!", {
		Name = "TutorialPointer",
		Size = UDim2.fromOffset(150, 44),
		Position = UDim2.new(0, 224, 0.5, -84),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Yellow,
		Visible = false,
		ZIndex = 30,
	}, Colors.Outline, 3)
end

local function show(index: number)
	local step = Tutorial.step(index)
	if not step then
		return
	end
	shownStep = index
	iconLabel.Text = step.Icon
	stepLabel.Text = `STEP {index} OF {#Tutorial.Steps}`
	titleLabel.Text = step.Title
	textLabel.Text = if isTouch() then step.TouchText else step.Text
	for i, segment in segments do
		segment.BackgroundColor3 = if i < index then Colors.Green elseif i == index then Colors.Yellow else Colors.Dark
	end
	card.BackgroundColor3 = Colors.Panel
	cardStroke.Color = Colors.Yellow
	cardWanted = true
	card.Position = CARD_POSITION - UDim2.fromOffset(0, 160)
	UIKit.tween(card, 0.45, { Position = CARD_POSITION }, Enum.EasingStyle.Back)
	SoundPlayer.play("Whoosh")
end

local function update()
	local index = State.tutorialStep()
	HUD.setTutorialActive(index ~= nil)
	if celebrating then
		return
	end
	if not index then
		cardWanted = false
		pointer.Visible = false
		shownStep = nil
		return
	end
	if index ~= shownStep then
		show(index)
	end
end

-- Big "YOU'RE A SHOPKEEPER!" finale.
local function finale(reward: number)
	local popup = UIKit.new("Frame", {
		Name = "TutorialDone",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(520, 220),
		BackgroundColor3 = Colors.Gold,
		ZIndex = 60,
	}, screen)
	UIKit.corner(popup, UDim.new(0, 28))
	UIKit.stroke(popup, Colors.Outline, 5)
	UIKit.gradient(popup, Color3.fromRGB(255, 255, 255), Color3.fromRGB(230, 170, 60))
	UIKit.shine(popup, UDim.new(0, 28), 1.2)
	UIKit.title(popup, "🎉 YOU'RE A SHOPKEEPER! 🎉", {
		Size = UDim2.new(1, -40, 0, 56),
		Position = UDim2.fromOffset(20, 26),
		ZIndex = 61,
	}, UIKit.darken(Colors.Gold, 0.6), 4)
	UIKit.title(popup, "BONUS +" .. Format.money(reward), {
		Size = UDim2.new(1, -40, 0, 50),
		Position = UDim2.fromOffset(20, 92),
		TextColor3 = Color3.fromRGB(120, 255, 130),
		ZIndex = 61,
	}, Colors.Outline, 4)
	UIKit.label(popup, "Keep filling your shelves and upgrading your shop!", {
		Size = UDim2.new(1, -60, 0, 28),
		Position = UDim2.fromOffset(30, 158),
		ZIndex = 61,
	})
	UIKit.popIn(popup, 0.5)
	Effects.confetti(90)
	SoundPlayer.play("Rare")
	HUD.flyCoinsFrom(Vector2.new(popup.AbsolutePosition.X + 260, popup.AbsolutePosition.Y + 117), reward)
	task.delay(4, function()
		UIKit.tween(UIKit.scaleOf(popup), 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.32)
		popup:Destroy()
	end)
end

local function celebrate(payload: { [string]: any })
	celebrating = true
	pointer.Visible = false
	local reward = if type(payload.Reward) == "number" then payload.Reward else 0
	cardWanted = true
	card.Visible = true
	card.BackgroundColor3 = UIKit.darken(Colors.Green, 0.25)
	cardStroke.Color = Colors.Green
	iconLabel.Text = "✅"
	stepLabel.Text = "STEP COMPLETE"
	titleLabel.Text = "NICE WORK!"
	textLabel.Text = "+" .. Format.money(reward) .. " reward"
	if shownStep and segments[shownStep] then
		segments[shownStep].BackgroundColor3 = Colors.Green
	end
	UIKit.pop(card, 0.12)
	SoundPlayer.play("StepDone")
	Effects.confetti(40)
	local center = card.AbsolutePosition + card.AbsoluteSize / 2
	local scale = screen:FindFirstChildOfClass("UIScale")
	local s = if scale then scale.Scale else 1
	HUD.flyCoinsFrom(Vector2.new(center.X / s, center.Y / s), reward)
	task.delay(1.7, function()
		celebrating = false
		if payload.Finished then
			cardWanted = false
			shownStep = nil
			finale(if type(payload.FinishReward) == "number" then payload.FinishReward else 0)
		end
		update()
	end)
end

function TutorialUI.init(gui: ScreenGui)
	screen = gui
	build()
	State.Changed:Connect(update)
	Effects.on("TutorialStep", celebrate)
	update()
	RunService.RenderStepped:Connect(function()
		local index = State.tutorialStep()
		local step = index and Tutorial.step(index)
		local wantsUpgrade = step ~= nil and step.Id == "Upgrade" and not celebrating
		pointer.Visible = wantsUpgrade and not Window.isAnyOpen()
		if pointer.Visible then
			pointer.Position = UDim2.new(0, 224 + math.abs(math.sin(os.clock() * 5)) * 16, 0.5, -84)
		end
		card.Visible = cardWanted and (celebrating or not Window.isAnyOpen())
		Notifications.setTopOffset(if card.Visible then 132 else 0)
	end)
end

return TutorialUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[--!strict
-- Building blocks for the chunky, bouncy "simulator" style UI.

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UIKit = {}

UIKit.Font = Enum.Font.FredokaOne -- body text
UIKit.Title = Enum.Font.LuckiestGuy -- big numbers, buttons, headings
-- The Robux logo. It ships inside every Roblox client, so it needs no upload.
UIKit.RobuxImage = "rbxasset://textures/ui/common/robux.png"

UIKit.Colors = {
	Dark = Color3.fromRGB(26, 28, 42),
	Outline = Color3.fromRGB(20, 20, 32),
	Panel = Color3.fromRGB(40, 43, 64),
	PanelLight = Color3.fromRGB(58, 62, 92),
	White = Color3.fromRGB(255, 255, 255),
	Green = Color3.fromRGB(80, 220, 90),
	GreenDark = Color3.fromRGB(30, 140, 50),
	Blue = Color3.fromRGB(70, 160, 255),
	BlueDark = Color3.fromRGB(25, 90, 200),
	Yellow = Color3.fromRGB(255, 210, 50),
	Gold = Color3.fromRGB(255, 196, 37),
	GoldDark = Color3.fromRGB(190, 120, 0),
	Orange = Color3.fromRGB(255, 150, 40),
	Red = Color3.fromRGB(255, 75, 85),
	RedDark = Color3.fromRGB(170, 25, 40),
	Pink = Color3.fromRGB(255, 90, 170),
	Purple = Color3.fromRGB(160, 95, 255),
	PurpleDark = Color3.fromRGB(90, 40, 180),
	Grey = Color3.fromRGB(130, 134, 150),
	GreyDark = Color3.fromRGB(80, 84, 100),
}

function UIKit.darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

function UIKit.lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

-- Create an instance, set properties, parent it last.
function UIKit.new(className: string, props: { [string]: any }?, parent: Instance?): any
	local instance = Instance.new(className :: any)
	if props then
		for key, value in props do
			(instance :: any)[key] = value
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIKit.corner(parent: Instance, radius: UDim?): UICorner
	return UIKit.new("UICorner", { CornerRadius = radius or UDim.new(0, 14) }, parent)
end

function UIKit.stroke(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	return UIKit.new("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function UIKit.textStroke(parent: Instance, color: Color3, thickness: number): UIStroke
	return UIKit.new("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}, parent)
end

function UIKit.padding(parent: Instance, pixels: number): UIPadding
	local p = UDim.new(0, pixels)
	return UIKit.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p }, parent)
end

function UIKit.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	}, parent)
end

function UIKit.rainbow(): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
		ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 190, 60)),
		ColorSequenceKeypoint.new(0.4, Color3.fromRGB(110, 230, 90)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 190, 255)),
		ColorSequenceKeypoint.new(0.8, Color3.fromRGB(160, 100, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 190)),
	})
end

function UIKit.label(parent: Instance?, text: string, props: { [string]: any }?): TextLabel
	local label = UIKit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		Text = text,
		TextColor3 = UIKit.Colors.White,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
	}, nil)
	if props then
		for key, value in props do
			(label :: any)[key] = value
		end
	end
	label.Parent = parent
	return label
end

-- Big outlined heading text (LuckiestGuy with a dark stroke).
function UIKit.title(parent: Instance?, text: string, props: { [string]: any }?, strokeColor: Color3?, strokeThickness: number?): TextLabel
	local label = UIKit.label(parent, text, props)
	label.Font = UIKit.Title
	UIKit.textStroke(label, strokeColor or UIKit.Colors.Outline, strokeThickness or 3)
	return label
end

function UIKit.tween(instance: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Every GuiObject that wants pop/press animations gets a UIScale.
function UIKit.scaleOf(object: GuiObject): UIScale
	local existing = object:FindFirstChild("PopScale")
	if existing and existing:IsA("UIScale") then
		return existing
	end
	return UIKit.new("UIScale", { Name = "PopScale" }, object)
end

-- Quick "boing" pop.
function UIKit.pop(object: GuiObject, amount: number?)
	local scale = UIKit.scaleOf(object)
	scale.Scale = 1 + (amount or 0.15)
	UIKit.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

-- Appear with a bounce from nothing.
function UIKit.popIn(object: GuiObject, time: number?)
	local scale = UIKit.scaleOf(object)
	scale.Scale = 0.2
	UIKit.tween(scale, time or 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

-- Horizontal shake for "can't afford" feedback.
function UIKit.shake(object: GuiObject)
	local origin = object.Position
	task.spawn(function()
		for _, dx in { -8, 8, -6, 6, -3, 0 } do
			object.Position = origin + UDim2.fromOffset(dx, 0)
			task.wait(0.03)
		end
		object.Position = origin
	end)
end

-- A shiny highlight band that sweeps across a (rounded) GuiObject now and then.
function UIKit.shine(object: GuiObject, radius: UDim?, interval: number?)
	local shine = UIKit.new("Frame", {
		Name = "Shine",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UIKit.Colors.White,
		BorderSizePixel = 0,
		ZIndex = object.ZIndex + 2,
	}, object)
	UIKit.corner(shine, radius)
	local gradient = UIKit.new("UIGradient", {
		Rotation = 20,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.42, 1),
			NumberSequenceKeypoint.new(0.5, 0.45),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Offset = Vector2.new(-1, 0),
	}, shine)
	task.spawn(function()
		while shine.Parent do
			gradient.Offset = Vector2.new(-1, 0)
			UIKit.tween(gradient, 0.7, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			task.wait(interval or 3)
		end
	end)
end

-- Gentle idle bob so important buttons feel alive.
function UIKit.wobble(object: GuiObject, degrees: number?)
	local amount = degrees or 4
	local offset = math.random() * 10
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not object.Parent then
			connection:Disconnect()
			return
		end
		object.Rotation = math.sin(os.clock() * 2.2 + offset) * amount
	end)
end

-- Gold "£" coin icon.
function UIKit.coin(parent: Instance?, size: number, props: { [string]: any }?): Frame
	local coin = UIKit.new("Frame", {
		Name = "Coin",
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = UIKit.Colors.Gold,
	}, nil)
	UIKit.corner(coin, UDim.new(1, 0))
	UIKit.stroke(coin, UIKit.Colors.GoldDark, math.max(2, size / 16))
	UIKit.gradient(coin, Color3.fromRGB(255, 255, 255), Color3.fromRGB(230, 200, 150))
	UIKit.title(coin, "£", {
		Size = UDim2.fromScale(0.7, 0.7),
		Position = UDim2.fromScale(0.15, 0.17),
		TextColor3 = Color3.fromRGB(255, 250, 220),
	}, UIKit.Colors.GoldDark, math.max(1.5, size / 22))
	if props then
		for key, value in props do
			(coin :: any)[key] = value
		end
	end
	coin.Parent = parent
	return coin
end

-- White Robux logo with a dark drop shadow so it reads on any colour.
function UIKit.robuxIcon(parent: Instance?, size: number, props: { [string]: any }?): Frame
	local holder = UIKit.new("Frame", {
		Name = "RobuxIcon",
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
	}, nil)
	if props then
		for key, value in props do
			(holder :: any)[key] = value
		end
	end
	local shadowOffset = math.max(1, math.floor(size / 12))
	UIKit.new("ImageLabel", {
		Name = "Shadow",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(shadowOffset, shadowOffset),
		BackgroundTransparency = 1,
		Image = UIKit.RobuxImage,
		ImageColor3 = UIKit.Colors.Outline,
		ImageTransparency = 0.3,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = holder.ZIndex,
	}, holder)
	UIKit.new("ImageLabel", {
		Name = "Logo",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = UIKit.RobuxImage,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = holder.ZIndex + 1,
	}, holder)
	holder.Parent = parent
	return holder
end

export type RobuxPrice = {
	Frame: Frame,
	Icon: Frame,
	Amount: TextLabel,
	-- Show a Robux price, or plain text (e.g. "OWNED ✔") without the logo.
	Set: (amount: number?, text: string?) -> (),
}

-- "[R$ logo] 249" centred inside `parent` (e.g. a chunky button's face).
function UIKit.robuxPrice(parent: Instance, textSize: number, strokeColor: Color3, zIndex: number): RobuxPrice
	local row = UIKit.new("Frame", {
		Name = "Price",
		Size = UDim2.new(1, -12, 0.8, 0),
		Position = UDim2.new(0, 6, 0.1, 0),
		BackgroundTransparency = 1,
		ZIndex = zIndex,
	}, parent)
	UIKit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, math.floor(textSize / 5)),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)
	local icon = UIKit.robuxIcon(row, textSize, { LayoutOrder = 1, ZIndex = zIndex })
	local amount = UIKit.title(row, "0", {
		Name = "Amount",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, textSize + 4),
		TextScaled = false,
		TextSize = textSize,
		LayoutOrder = 2,
		ZIndex = zIndex,
	}, strokeColor, 2.5)
	return {
		Frame = row,
		Icon = icon,
		Amount = amount,
		Set = function(price: number?, text: string?)
			icon.Visible = price ~= nil
			amount.Text = if price then tostring(price) else (text or "")
		end,
	}
end

function UIKit.badge(parent: Instance, color: Color3, text: string): (Frame, TextLabel)
	local frame = UIKit.new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = color,
		Visible = false,
		ZIndex = 20,
	}, parent)
	UIKit.corner(frame, UDim.new(1, 0))
	UIKit.stroke(frame, UIKit.Colors.White, 3)
	local label = UIKit.title(frame, text, {
		Size = UDim2.fromScale(0.78, 0.78),
		Position = UDim2.fromScale(0.11, 0.13),
		ZIndex = 21,
	}, UIKit.darken(color, 0.5), 1.5)
	return frame, label
end

export type Chunky = {
	Button: TextButton,
	Face: Frame,
	Base: Frame,
	Icon: TextLabel?,
	Text: TextLabel?,
	SetColor: (color: Color3) -> (),
}

-- Chunky 3D button: a coloured face sitting on a darker base; it presses
-- down when clicked and grows a little on hover.
function UIKit.chunky(parent: Instance?, props: { [string]: any }, onClick: () -> ()): Chunky
	local color: Color3 = props.Color or UIKit.Colors.Green
	local depth = props.Depth or 6
	local button = UIKit.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 56),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	}, nil)
	local z = button.ZIndex
	local base = UIKit.new("Frame", {
		Name = "Base",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UIKit.darken(color, 0.35),
		ZIndex = z,
	}, button)
	local radius = props.Radius or UDim.new(0, 14)
	UIKit.corner(base, radius)
	UIKit.stroke(base, UIKit.Colors.Outline, props.StrokeThickness or 3)
	local face = UIKit.new("Frame", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -depth),
		BackgroundColor3 = color,
		ZIndex = z + 1,
	}, button)
	UIKit.corner(face, radius)
	UIKit.gradient(face, Color3.fromRGB(255, 255, 255), Color3.fromRGB(205, 205, 205))
	-- Glossy highlight on the top half.
	local gloss = UIKit.new("Frame", {
		Name = "Gloss",
		Size = UDim2.new(1, -8, 0.42, 0),
		Position = UDim2.fromOffset(4, 3),
		BackgroundColor3 = UIKit.Colors.White,
		BackgroundTransparency = 0.72,
		ZIndex = z + 2,
	}, face)
	UIKit.corner(gloss, radius)

	local icon: TextLabel? = nil
	local text: TextLabel? = nil
	if props.Icon and props.Text then
		icon = UIKit.label(face, props.Icon, {
			Name = "Icon",
			Size = UDim2.fromScale(0.62, 0.56),
			Position = UDim2.fromScale(0.19, 0.06),
			ZIndex = z + 3,
		})
		text = UIKit.title(face, props.Text, {
			Name = "Label",
			Size = UDim2.fromScale(0.9, 0.3),
			Position = UDim2.fromScale(0.05, 0.64),
			ZIndex = z + 3,
		}, UIKit.darken(color, 0.55), 2)
	elseif props.Icon then
		icon = UIKit.label(face, props.Icon, {
			Name = "Icon",
			Size = UDim2.fromScale(0.72, 0.72),
			Position = UDim2.fromScale(0.14, 0.14),
			ZIndex = z + 3,
		})
	elseif props.Text then
		text = UIKit.title(face, props.Text, {
			Name = "Label",
			Size = UDim2.new(1, -16, 0.72, 0),
			Position = UDim2.new(0, 8, 0.14, 0),
			ZIndex = z + 3,
		}, UIKit.darken(color, 0.55), props.TextStroke or 2.5)
		if props.MaxTextSize then
			UIKit.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize }, text)
		end
	end

	local scale = UIKit.scaleOf(button)
	local function press()
		UIKit.tween(face, 0.06, { Position = UDim2.fromOffset(0, depth - 2) })
	end
	local function release()
		UIKit.tween(face, 0.12, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	end
	button.MouseButton1Down:Connect(press)
	button.MouseButton1Up:Connect(release)
	button.MouseEnter:Connect(function()
		UIKit.tween(scale, 0.15, { Scale = 1.06 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		release()
		UIKit.tween(scale, 0.15, { Scale = 1 })
	end)
	button.Activated:Connect(onClick)
	button.Parent = parent

	local chunky: Chunky = {
		Button = button,
		Face = face,
		Base = base,
		Icon = icon,
		Text = text,
		SetColor = function(newColor: Color3)
			face.BackgroundColor3 = newColor
			base.BackgroundColor3 = UIKit.darken(newColor, 0.35)
			if text then
				local stroke = text:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Color = UIKit.darken(newColor, 0.55)
				end
			end
		end,
	}
	return chunky
end

-- Dark translucent rounded "pill" panel.
function UIKit.pill(parent: Instance?, props: { [string]: any }): Frame
	local frame = UIKit.new("Frame", {
		BackgroundColor3 = UIKit.Colors.Dark,
		BackgroundTransparency = 0.15,
	}, nil)
	for key, value in props do
		(frame :: any)[key] = value
	end
	UIKit.corner(frame, UDim.new(1, 0))
	UIKit.stroke(frame, UIKit.Colors.Outline, 3)
	frame.Parent = parent
	return frame
end

return UIKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">UpgradesPanel</string>
              <string name="Source"><![CDATA[--!strict
-- The upgrade menu. Purchases are validated by the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Tutorial = require(Shared:WaitForChild("Tutorial"))
local Upgrades = require(Shared:WaitForChild("Upgrades"))

local SoundPlayer = require(script.Parent.SoundPlayer)
local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Window = require(script.Parent.Window)

local Colors = UIKit.Colors

local UpgradesPanel = {}

type Row = {
	Frame: Frame,
	Level: TextLabel,
	Effect: TextLabel,
	Pips: { Frame },
	Buy: UIKit.Chunky,
	Glow: UIStroke,
	Color: Color3,
}

local window: Window.Window
local rows: { [string]: Row } = {}
local buying = false

local function tutorialWantsUpgrade(): boolean
	local step = State.tutorialStep()
	local def = step and Tutorial.step(step)
	return def ~= nil and def.Id == "Upgrade"
end

local function refresh()
	local data = State.Data
	if not data then
		return
	end
	local highlight = tutorialWantsUpgrade()
	for id, row in rows do
		local def = Upgrades.Defs[id]
		local level = data.Upgrades[id] or def.StartLevel
		local cost = Upgrades.getCost(id, level)
		local shownLevel = level - def.StartLevel
		row.Level.Text = `LV {shownLevel}/{def.MaxLevel - def.StartLevel}`
		for index, pip in row.Pips do
			pip.BackgroundColor3 = if index <= shownLevel then row.Color else Color3.fromRGB(30, 32, 48)
		end
		local label = row.Buy.Text
		if cost then
			row.Effect.Text = `{def.Effect(level)}  ➜  {def.Effect(level + 1)}`
			local affordable = data.Cash >= cost
			if label then
				label.Text = Format.money(cost)
			end
			row.Buy.SetColor(if affordable then Colors.Green else Colors.GreyDark)
			row.Glow.Enabled = highlight and affordable
		else
			row.Effect.Text = def.Effect(level)
			if label then
				label.Text = "MAX"
			end
			row.Buy.SetColor(Colors.Gold)
			row.Glow.Enabled = false
		end
	end
	window.Subtitle.Text = `You have {Format.money(data.Cash)}`
end

local function celebrate(row: Row)
	UIKit.pop(row.Frame, 0.06)
	local flash = UIKit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.White,
		BackgroundTransparency = 0.2,
		ZIndex = 40,
	}, row.Frame)
	UIKit.corner(flash, UDim.new(0, 18))
	UIKit.tween(flash, 0.45, { BackgroundTransparency = 1 })
	local plus = UIKit.title(row.Frame, "LEVEL UP!", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.45, 0.5),
		Size = UDim2.fromOffset(220, 44),
		TextColor3 = Colors.Yellow,
		ZIndex = 41,
	}, Colors.Outline, 3)
	UIKit.popIn(plus)
	UIKit.tween(plus, 0.9, { Position = UDim2.fromScale(0.45, -0.1), TextTransparency = 1 })
	task.delay(0.95, function()
		flash:Destroy()
		plus:Destroy()
	end)
end

local function buy(id: string, row: Row)
	if buying then
		return
	end
	buying = true
	local ok, success, message = pcall(function()
		return Remotes.func("BuyUpgrade"):InvokeServer(id)
	end)
	buying = false
	if ok and success then
		SoundPlayer.play("Upgrade")
		SoundPlayer.play("Purchase", 1.1)
		celebrate(row)
	else
		SoundPlayer.play("Error")
		UIKit.shake(row.Buy.Button)
		if ok and type(message) == "string" then
			window.Subtitle.Text = "⚠️ " .. message
		end
	end
end

local function makeRow(parent: Instance, id: string, order: number): Row
	local def = Upgrades.Defs[id]
	local frame = UIKit.new("Frame", {
		Name = id,
		Size = UDim2.new(1, -12, 0, 100),
		BackgroundColor3 = Colors.PanelLight,
		LayoutOrder = order,
		ZIndex = 22,
	}, parent)
	UIKit.corner(frame, UDim.new(0, 18))
	UIKit.stroke(frame, Colors.Outline, 3)

	local tile = UIKit.new("Frame", {
		Size = UDim2.fromOffset(76, 76),
		Position = UDim2.fromOffset(12, 8),
		BackgroundColor3 = def.Color,
		ZIndex = 23,
	}, frame)
	UIKit.corner(tile, UDim.new(0, 16))
	UIKit.stroke(tile, UIKit.darken(def.Color, 0.45), 3)
	UIKit.gradient(tile, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 200))
	UIKit.label(tile, def.Icon, { Size = UDim2.fromScale(0.72, 0.72), Position = UDim2.fromScale(0.14, 0.14), ZIndex = 24 })

	UIKit.title(frame, string.upper(def.Name), {
		Size = UDim2.new(1, -290, 0, 30),
		Position = UDim2.fromOffset(100, 10),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 23,
	}, Colors.Outline, 2.5)
	-- Level pill hanging off the bottom of the icon tile.
	local levelPill = UIKit.new("Frame", {
		Name = "LevelPill",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(70, 22),
		BackgroundColor3 = Colors.Outline,
		ZIndex = 25,
	}, tile)
	UIKit.corner(levelPill, UDim.new(1, 0))
	UIKit.stroke(levelPill, UIKit.darken(def.Color, 0.35), 2)
	local level = UIKit.title(levelPill, "LV 0", {
		Size = UDim2.new(1, -10, 1, -6),
		Position = UDim2.fromOffset(5, 3),
		TextColor3 = Colors.Yellow,
		ZIndex = 26,
	}, Colors.Outline, 1.5)

	-- Level pips
	local pipCount = def.MaxLevel - def.StartLevel
	local pipBar = UIKit.new("Frame", {
		Size = UDim2.new(1, -290, 0, 12),
		Position = UDim2.fromOffset(100, 45),
		BackgroundTransparency = 1,
		ZIndex = 23,
	}, frame)
	UIKit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, pipBar)
	local pips = {}
	for index = 1, pipCount do
		local pip = UIKit.new("Frame", {
			Size = UDim2.new(1 / pipCount, -4, 1, 0),
			BackgroundColor3 = Color3.fromRGB(30, 32, 48),
			LayoutOrder = index,
			ZIndex = 24,
		}, pipBar)
		UIKit.corner(pip, UDim.new(1, 0))
		pips[index] = pip
	end

	local effect = UIKit.label(frame, def.Description, {
		Size = UDim2.new(1, -290, 0, 24),
		Position = UDim2.fromOffset(100, 64),
		TextColor3 = Color3.fromRGB(220, 225, 245),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 23,
	})

	local row: Row
	local buyButton = UIKit.chunky(frame, {
		Name = "Buy",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(150, 64),
		Color = Colors.Green,
		Text = "£0",
		ZIndex = 24,
		MaxTextSize = 30,
	}, function()
		buy(id, row)
	end)
	local glow = UIKit.stroke(buyButton.Base, Colors.Yellow, 5)
	glow.Enabled = false
	row = {
		Frame = frame,
		Level = level,
		Effect = effect,
		Pips = pips,
		Buy = buyButton,
		Glow = glow,
		Color = def.Color,
	}
	return row
end

function UpgradesPanel.init(screen: ScreenGui)
	window = Window.new(screen, { Title = "UPGRADES", Icon = "⬆️", Color = Colors.Green })
	local list = UIKit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Colors.Grey,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 22,
	}, window.Content)
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	UIKit.padding(list, 6)
	for order, id in Upgrades.Order do
		rows[id] = makeRow(list, id, order)
	end
	window.OnOpen = refresh
	State.Changed:Connect(function()
		if window:IsOpen() then
			refresh()
		end
	end)
	-- Pulse the tutorial glow.
	RunService.RenderStepped:Connect(function()
		if not window:IsOpen() then
			return
		end
		local pulse = 3 + math.abs(math.sin(os.clock() * 5)) * 4
		for _, row in rows do
			if row.Glow.Enabled then
				row.Glow.Thickness = pulse
			end
		end
	end)
end

function UpgradesPanel.toggle()
	Window.toggle(window)
end

function UpgradesPanel.isOpen(): boolean
	return window:IsOpen()
end

return UpgradesPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Window</string>
              <string name="Source"><![CDATA[--!strict
-- Pop-up menu window: dimmed backdrop, coloured ribbon header, big red X,
-- optional tabs. Only one window is open at a time.

local SoundPlayer = require(script.Parent.SoundPlayer)
local UIKit = require(script.Parent.UIKit)

local Colors = UIKit.Colors

export type Window = {
	Frame: Frame,
	Content: Frame,
	Subtitle: TextLabel,
	Open: (self: Window) -> (),
	Close: (self: Window) -> (),
	IsOpen: (self: Window) -> boolean,
	OnOpen: (() -> ())?,
	SelectTab: ((key: string) -> ())?,
}

export type Options = {
	Title: string,
	Icon: string,
	Color: Color3,
	Width: number?,
	Height: number?,
}

export type Tab = { Key: string, Text: string, Color: Color3 }

local Window = {}

local openWindow: Window? = nil
local backdrop: TextButton? = nil

local function ensureBackdrop(screen: ScreenGui): TextButton
	if backdrop then
		return backdrop
	end
	local dim = UIKit.new("TextButton", {
		Name = "Backdrop",
		Size = UDim2.new(1, 0, 1, 200),
		Position = UDim2.fromOffset(0, -100),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 18,
	}, screen)
	dim.Activated:Connect(function()
		if openWindow then
			openWindow:Close()
		end
	end)
	backdrop = dim
	return dim
end

function Window.new(screen: ScreenGui, options: Options): Window
	local width = options.Width or 620
	local height = options.Height or 460
	local color = options.Color
	local dim = ensureBackdrop(screen)

	local frame = UIKit.new("Frame", {
		Name = options.Title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 18),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = Colors.Panel,
		Visible = false,
		ZIndex = 20,
	}, screen)
	UIKit.corner(frame, UDim.new(0, 26))
	UIKit.stroke(frame, Colors.Outline, 5)
	UIKit.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 195, 215))

	-- Ribbon header sitting on the top edge.
	local ribbon = UIKit.new("Frame", {
		Name = "Header",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0.62, 0, 0, 62),
		BackgroundColor3 = color,
		ZIndex = 23,
	}, frame)
	UIKit.corner(ribbon, UDim.new(0, 20))
	UIKit.stroke(ribbon, Colors.Outline, 4)
	UIKit.gradient(ribbon, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 200))
	UIKit.title(ribbon, `{options.Icon} {options.Title}`, {
		Size = UDim2.new(1, -30, 1, -16),
		Position = UDim2.fromOffset(15, 8),
		ZIndex = 24,
	}, UIKit.darken(color, 0.55), 3)

	local subtitle = UIKit.label(frame, "", {
		Name = "Subtitle",
		Size = UDim2.new(1, -60, 0, 24),
		Position = UDim2.fromOffset(30, 42),
		TextColor3 = Color3.fromRGB(215, 220, 240),
		ZIndex = 21,
	})

	local content = UIKit.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -36, 1, -86),
		Position = UDim2.fromOffset(18, 72),
		BackgroundTransparency = 1,
		ZIndex = 21,
	}, frame)

	local self: Window
	self = {
		Frame = frame,
		Content = content,
		Subtitle = subtitle,
		OnOpen = nil,
		SelectTab = nil,
		Open = function(window: Window)
			if openWindow and openWindow ~= window then
				openWindow:Close()
			end
			openWindow = window
			frame.Visible = true
			dim.Visible = true
			UIKit.popIn(frame, 0.32)
			SoundPlayer.play("Whoosh")
			if window.OnOpen then
				window.OnOpen()
			end
		end,
		Close = function(window: Window)
			if openWindow == window then
				openWindow = nil
				dim.Visible = false
			end
			frame.Visible = false
		end,
		IsOpen = function(_window: Window): boolean
			return frame.Visible
		end,
	}

	local close = UIKit.chunky(frame, {
		Name = "Close",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(56, 56),
		Color = Colors.Red,
		Text = "X",
		Depth = 6,
		ZIndex = 25,
		Radius = UDim.new(0, 16),
	}, function()
		SoundPlayer.play("Click")
		self:Close()
	end)
	close.Button.Name = "Close"
	return self
end

-- Adds a row of tabs at the top of the content area. Returns the area below them.
function Window.tabs(window: Window, tabs: { Tab }, onSelect: (key: string) -> ()): Frame
	local content = window.Content
	local bar = UIKit.new("Frame", {
		Name = "Tabs",
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
		ZIndex = 22,
	}, content)
	UIKit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, bar)
	local body = UIKit.new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 1, -60),
		Position = UDim2.fromOffset(0, 60),
		BackgroundTransparency = 1,
		ZIndex = 22,
	}, content)
	local chunkies: { [string]: UIKit.Chunky } = {}
	local function select(key: string)
		for _, tab in tabs do
			chunkies[tab.Key].SetColor(if tab.Key == key then tab.Color else Colors.GreyDark)
		end
		onSelect(key)
	end
	for order, tab in tabs do
		chunkies[tab.Key] = UIKit.chunky(bar, {
			Name = tab.Key,
			Size = UDim2.fromOffset(170, 46),
			Color = tab.Color,
			Text = tab.Text,
			Depth = 5,
			LayoutOrder = order,
			ZIndex = 23,
			MaxTextSize = 24,
		}, function()
			SoundPlayer.play("Click")
			select(tab.Key)
		end)
	end
	window.SelectTab = select
	return body
end

function Window.isAnyOpen(): boolean
	return openWindow ~= nil
end

function Window.closeAll()
	if openWindow then
		openWindow:Close()
	end
end

-- Toggle helper for HUD buttons.
function Window.toggle(window: Window)
	if window:IsOpen() then
		window:Close()
	else
		window:Open()
	end
end

return Window
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="77">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Fill the Store! — client entry point. Builds the UI and starts the
-- client-side controllers in ./Controllers.

local Players = game:GetService("Players")

local Controllers = script.Parent.Controllers
local Effects = require(Controllers.Effects)
local Guide = require(Controllers.Guide)
local HUD = require(Controllers.HUD)
local LeaderboardPanel = require(Controllers.LeaderboardPanel)
local Notifications = require(Controllers.Notifications)
local Prompts = require(Controllers.Prompts)
local ShopPanel = require(Controllers.ShopPanel)
local SoundPlayer = require(Controllers.SoundPlayer)
local State = require(Controllers.State)
local StockPanel = require(Controllers.StockPanel)
local TutorialUI = require(Controllers.TutorialUI)
local UpgradesPanel = require(Controllers.UpgradesPanel)

local player = Players.LocalPlayer

local screen = Instance.new("ScreenGui")
screen.Name = "FillTheStoreUI"
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.IgnoreGuiInset = false

-- Scale the whole UI down on small (mobile) screens.
local uiScale = Instance.new("UIScale")
uiScale.Parent = screen
local function updateScale()
	local camera = workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		uiScale.Scale = math.clamp(math.min(size.X / 1150, size.Y / 720), 0.55, 1.15)
	end
end
updateScale()
local function watchCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		updateScale()
	end
end
watchCamera()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)

screen.Parent = player:WaitForChild("PlayerGui")

SoundPlayer.init()
State.init()
HUD.init(screen)
Notifications.init(screen)
UpgradesPanel.init(screen)
StockPanel.init(screen)
ShopPanel.init(screen)
LeaderboardPanel.init(screen)
Effects.init(screen)
Prompts.init()
Guide.init()
TutorialUI.init(screen)

HUD.UpgradesPressed:Connect(UpgradesPanel.toggle)
HUD.StockPressed:Connect(StockPanel.toggle)
HUD.LeadersPressed:Connect(LeaderboardPanel.toggle)
HUD.ShopPressed:Connect(function(tab: string?)
	if tab then
		ShopPanel.open(tab)
	else
		ShopPanel.toggle()
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
