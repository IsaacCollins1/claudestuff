  </Item>
  <Item class="SoundService" referent="41">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="42">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="43">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">90</float>
      <float name="CameraMinZoomDistance">6</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="44">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="46">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- World-space feedback: box opening animation, money popups, products
-- popping onto shelves, rainbow items, confetti, sounds.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BoxVisual = require(Shared:WaitForChild("BoxVisual"))
local Format = require(Shared:WaitForChild("Format"))
local Items = require(Shared:WaitForChild("Items"))
local ProductVisuals = require(Shared:WaitForChild("ProductVisuals"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Notifications = require(script.Parent.Notifications)
local SoundPlayer = require(script.Parent.SoundPlayer)
local UIKit = require(script.Parent.UIKit)

local Colors = UIKit.Colors
local player = Players.LocalPlayer
local rng = Random.new()

local Effects = {}

local function cameraPosition(): Vector3
	local camera = workspace.CurrentCamera
	return if camera then camera.CFrame.Position else Vector3.zero
end

local function near(position: Vector3, distance: number): boolean
	return (cameraPosition() - position).Magnitude <= distance
end

-- Invisible anchored part used to hold billboards/particles/sounds.
local function anchorAt(position: Vector3, lifetime: number): Part
	local part = Instance.new("Part")
	part.Name = "EffectAnchor"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Position = position
	part.Parent = workspace
	Debris:AddItem(part, lifetime)
	return part
end

-- Floating text that rises and fades ("+£24").
local function floatText(position: Vector3, text: string, color: Color3, size: number, rainbow: boolean?)
	local anchor = anchorAt(position, 2)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(size * 3.2, size)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 160
	gui.Parent = anchor
	local label = UIKit.label(gui, text, { TextColor3 = color })
	UIKit.textStroke(label, Colors.Dark, 3)
	if rainbow then
		label.TextColor3 = Colors.White
		UIKit.new("UIGradient", { Color = UIKit.rainbow() }, label)
	end
	local scale = UIKit.scaleOf(label)
	scale.Scale = 0.3
	UIKit.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	UIKit.tween(gui, 1.4, { StudsOffsetWorldSpace = Vector3.new(0, 4, 0) })
	task.delay(0.9, function()
		UIKit.tween(label, 0.5, { TextTransparency = 1 })
	end)
end

local function burst(position: Vector3, colors: { Color3 }, count: number, speed: number)
	local anchor = anchorAt(position, 3)
	for _, color in colors do
		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(color)
		emitter.LightEmission = 0.8
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		emitter.Lifetime = NumberRange.new(0.6, 1.2)
		emitter.Speed = NumberRange.new(speed * 0.5, speed)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, -18, 0)
		emitter.RotSpeed = NumberRange.new(-200, 200)
		emitter.Rate = 0
		emitter.Parent = anchor
		emitter:Emit(math.max(1, math.floor(count / #colors)))
	end
end

local RAINBOW_COLORS = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(110, 230, 90),
	Color3.fromRGB(70, 190, 255),
	Color3.fromRGB(180, 100, 255),
}

-- Animate a value from 0 to 1 over `duration`, calling `step(alpha)` each frame.
local function animate(duration: number, step: (alpha: number) -> ())
	local start = os.clock()
	while true do
		local alpha = math.min((os.clock() - start) / duration, 1)
		step(alpha)
		if alpha >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
end

local function ease(alpha: number, style: Enum.EasingStyle, direction: Enum.EasingDirection): number
	return TweenService:GetValue(alpha, style, direction)
end

-- Box opening -------------------------------------------------------------------

local function boxOpen(payload: { [string]: any })
	local cframe = payload.CFrame :: CFrame
	local contents = payload.Contents :: { { Key: string, Count: number } }
	local mine = payload.OwnerId == player.UserId
	if typeof(cframe) ~= "CFrame" or type(contents) ~= "table" or #contents == 0 then
		return
	end
	if not mine and not near(cframe.Position, 90) then
		return
	end

	local tape = if typeof(payload.TapeColor) == "Color3" then payload.TapeColor else Color3.fromRGB(196, 150, 96)
	local box = BoxVisual.build(tape, true)
	box.Model:PivotTo(cframe)
	box.Model.Parent = workspace
	local size = BoxVisual.Size

	-- 1) Shake
	SoundPlayer.play("BoxShake", 1, cframe.Position)
	for i = 1, 6 do
		local tilt = if i % 2 == 0 then 1 else -1
		box.Model:PivotTo(cframe * CFrame.new(0, 0.1 * (i % 2), 0) * CFrame.Angles(math.rad(3 * tilt), 0, math.rad(7 * tilt)))
		task.wait(0.05)
	end
	box.Model:PivotTo(cframe)

	-- 2) Flaps swing open
	SoundPlayer.play("BoxOpen", 1, cframe.Position)
	local left, right = box.FlapLeft, box.FlapRight
	local hingeY = size.Y / 2 + 0.04
	animate(0.18, function(alpha)
		local angle = math.rad(115) * ease(alpha, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		if left then
			left.CFrame = cframe * CFrame.new(-size.X / 2, hingeY, 0) * CFrame.Angles(0, 0, angle) * CFrame.new(size.X / 4, 0, 0)
		end
		if right then
			right.CFrame = cframe * CFrame.new(size.X / 2, hingeY, 0) * CFrame.Angles(0, 0, -angle) * CFrame.new(-size.X / 4, 0, 0)
		end
	end)

	-- 3) Products pop out (rare ones first), then fly towards the player.
	local keys = {}
	local rare = false
	for index = #contents, 1, -1 do
		local entry = contents[index]
		rare = rare or Items.isRare(entry.Key)
		for _ = 1, math.min(entry.Count, 8 - #keys) do
			table.insert(keys, entry.Key)
		end
	end
	if mine then
		Notifications.boxOpened(contents)
	end
	local top = cframe.Position + Vector3.new(0, size.Y / 2, 0)
	local total = 0
	for _, entry in contents do
		total += entry.Count
	end
	local firstKey = contents[1].Key
	floatText(top + Vector3.new(0, 3.5, 0), `{Items.icon(firstKey)} {Items.product(firstKey).Name} x{total}`, Colors.White, 1.6)
	if rare then
		burst(top, RAINBOW_COLORS, 60, 22)
		SoundPlayer.play("Rare", 1, top)
	end

	for index, key in keys do
		task.spawn(function()
			local item = ProductVisuals.build(key)
			local angle = (index / #keys) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
			local peak = top + Vector3.new(math.cos(angle) * 2.4, 3.2 + rng:NextNumber(0, 1.2), math.sin(angle) * 2.4)
			item:ScaleTo(0.2)
			item:PivotTo(CFrame.new(top))
			item.Parent = workspace
			SoundPlayer.play("ItemPop", 1 + index * 0.06, top, 0.04)
			animate(0.35, function(alpha)
				local e = ease(alpha, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				item:ScaleTo(0.2 + 1.1 * e)
				item:PivotTo(CFrame.new(top:Lerp(peak, e)) * CFrame.Angles(0, alpha * math.pi * 2, 0))
			end)
			task.wait(0.35)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local destination = if mine and root and root:IsA("BasePart") then root.Position else peak + Vector3.new(0, 2, 0)
			local from = item:GetPivot().Position
			animate(0.3, function(alpha)
				local e = ease(alpha, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				item:ScaleTo(math.max(0.05, 1.3 * (1 - e)))
				item:PivotTo(CFrame.new(from:Lerp(destination, e)))
			end)
			item:Destroy()
		end)
		task.wait(0.05)
	end

	-- 4) Empty box shrinks away
	task.wait(0.5)
	animate(0.25, function(alpha)
		box.Model:ScaleTo(math.max(0.05, 1 - ease(alpha, Enum.EasingStyle.Back, Enum.EasingDirection.In)))
	end)
	box.Model:Destroy()
end

-- Handlers ------------------------------------------------------------------------

local handlers: { [string]: (payload: { [string]: any }) -> () } = {}

handlers.BoxOpen = boxOpen

handlers.Sale = function(payload)
	local position = payload.Position
	if typeof(position) ~= "Vector3" or not near(position, 140) then
		return
	end
	local amount = if type(payload.Amount) == "number" then payload.Amount else 0
	local mine = payload.OwnerId == player.UserId
	if payload.Rare then
		floatText(position, "+" .. Format.money(amount), Colors.Gold, 2.2, true)
		burst(position, { Colors.Gold, Colors.White }, 30, 14)
		SoundPlayer.play("Rare", 1, position)
	else
		floatText(position, "+" .. Format.money(amount), Colors.Green, if mine then 1.4 else 1.1)
	end
	SoundPlayer.play(if mine then "Cash" else "CashLow", rng:NextNumber(0.95, 1.1), position)
end

handlers.Stocked = function(payload)
	local position = payload.Position
	if typeof(position) ~= "Vector3" then
		return
	end
	if payload.Full then
		floatText(position, "FULL! ✔", Colors.Green, 1.3)
		SoundPlayer.play("Upgrade", 1.5, position)
	else
		floatText(position, `+{payload.Count} 📦`, Colors.Blue, 1.2)
	end
end

handlers.Pickup = function()
	SoundPlayer.play("Pickup")
end

handlers.BoxLand = function(payload)
	local position = payload.Position
	if typeof(position) == "Vector3" and near(position, 120) then
		SoundPlayer.play("Thud", rng:NextNumber(0.9, 1.1), position, 0.05)
		burst(position - Vector3.new(0, 1, 0), { Color3.fromRGB(230, 220, 200) }, 8, 6)
	end
end

handlers.Upgrade = function()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		burst(root.Position, { Colors.Green, Colors.Yellow, Colors.White }, 45, 18)
	end
end

handlers.StoreExpanded = function(payload)
	local position = payload.Position
	if typeof(position) ~= "Vector3" or not near(position, 250) then
		return
	end
	burst(position, RAINBOW_COLORS, 150, 40)
	SoundPlayer.play("Upgrade", 1, position)
	task.delay(0.15, function()
		SoundPlayer.play("Rare", 0.8, position)
	end)
end

handlers.Sad = function(payload)
	local position = payload.Position
	if payload.OwnerId == player.UserId and typeof(position) == "Vector3" and near(position, 80) then
		SoundPlayer.play("Sad", 1, position, 0.5)
	end
end

handlers.Delivery = function()
	-- The banner already plays a sound; nothing extra needed.
end

-- Products popping onto shelves --------------------------------------------------------

local function animateStock(item: Instance)
	if not item:IsA("Model") or not item:GetAttribute("Pop") then
		return
	end
	local pivot = item:GetPivot()
	if not near(pivot.Position, 80) then
		return
	end
	local fill = item:GetAttribute("Fill")
	SoundPlayer.play("Stock", 0.85 + (if type(fill) == "number" then fill else 0.5) * 0.9, pivot.Position, 0.025)
	task.spawn(function()
		item:ScaleTo(0.05)
		animate(0.22, function(alpha)
			if item.Parent == nil then
				return
			end
			local e = ease(alpha, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			item:ScaleTo(math.max(0.05, e))
			item:PivotTo(pivot * CFrame.new(0, (1 - alpha) * 0.9, 0))
		end)
		if item.Parent then
			item:ScaleTo(1)
			item:PivotTo(pivot)
		end
	end)
end

local function watchShelf(shelf: Instance)
	task.spawn(function()
		local items = shelf:WaitForChild("Items", 10)
		if items then
			items.ChildAdded:Connect(animateStock)
		end
	end)
end

-- Rainbow items cycle through colours ------------------------------------------------------

local function updateRainbows()
	local t = os.clock()
	for _, model in CollectionService:GetTagged(ProductVisuals.RainbowTag) do
		if model:IsA("Model") and model:IsDescendantOf(workspace) and near(model:GetPivot().Position, 100) then
			local index = 0
			for _, part in model:GetChildren() do
				if part:IsA("BasePart") then
					index += 1
					part.Color = Color3.fromHSV((t * 0.45 + index * 0.17) % 1, 0.75, 1)
				end
			end
		end
	end
end

function Effects.init()
	Remotes.event("Effect").OnClientEvent:Connect(function(name: string, payload: { [string]: any })
		local handler = handlers[name]
		if handler and type(payload) == "table" then
			task.spawn(handler, payload)
		end
	end)

	for _, shelf in CollectionService:GetTagged("Shelf") do
		watchShelf(shelf)
	end
	CollectionService:GetInstanceAddedSignal("Shelf"):Connect(watchShelf)

	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.05 then
			accumulator = 0
			updateRainbows()
		end
	end)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Guide</string>
              <string name="Source"><![CDATA[--!strict
-- Teaches the loop without text walls: a short hint at the bottom of the
-- screen, a bouncing arrow over the next thing to do, and (for new players)
-- a glowing line from the character to it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Upgrades = require(Shared:WaitForChild("Upgrades"))

local HUD = require(script.Parent.HUD)
local State = require(script.Parent.State)
local StoreQuery = require(script.Parent.StoreQuery)
local UIKit = require(script.Parent.UIKit)

local player = Players.LocalPlayer

local Guide = {}

local holder: Part
local marker: BillboardGui
local targetAttachment: Attachment
local beam: Beam
local characterAttachment: Attachment? = nil
local lastUpgradePulse = 0

local function isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

type Objective = { Hint: string?, Target: BasePart? }

local function nearest(parts: { BasePart }, from: Vector3): BasePart?
	local best: BasePart? = nil
	local bestDistance = math.huge
	for _, part in parts do
		local distance = (part.Position - from).Magnitude
		if distance < bestDistance then
			bestDistance = distance
			best = part
		end
	end
	return best
end

local function cheapestUpgrade(): number?
	local data = State.Data
	if not data then
		return nil
	end
	local cheapest: number? = nil
	for id, def in Upgrades.Defs do
		local cost = Upgrades.getCost(id, data.Upgrades[id] or def.StartLevel)
		if cost and (cheapest == nil or cost < cheapest) then
			cheapest = cost
		end
	end
	return cheapest
end

local function currentObjective(root: BasePart): Objective
	local store = StoreQuery.store()
	if not store then
		return { Hint = nil, Target = nil }
	end
	local press = if isTouch() then "Tap" else "Press E to"

	if player:GetAttribute("CarryingBox") == true then
		if StoreQuery.isInside(root.Position) then
			return { Hint = `📦 {press} open the box!`, Target = nil }
		end
		return { Hint = "🏪 Carry the box into your shop!", Target = StoreQuery.part(store, "DoorMat") }
	end

	local stock = State.inventoryTotal()
	local shelves = StoreQuery.shelves()
	if stock > 0 then
		local emptiest = nil
		local lowest = math.huge
		for _, shelf in shelves do
			if shelf.Capacity > 0 and shelf.Count < shelf.Capacity then
				local ratio = shelf.Count / shelf.Capacity
				if ratio < lowest then
					lowest = ratio
					emptiest = shelf
				end
			end
		end
		if emptiest then
			return { Hint = `🛒 {press} stock your shelves!`, Target = emptiest.Target }
		end
	end

	local boxes = StoreQuery.boxesOnPad()
	if #boxes > 0 then
		return { Hint = "📦 Grab a delivery box!", Target = nearest(boxes, root.Position) }
	end

	local data = State.Data
	local cheapest = cheapestUpgrade()
	if data and cheapest and data.Cash >= cheapest then
		if os.clock() - lastUpgradePulse > 3 then
			lastUpgradePulse = os.clock()
			HUD.pulseUpgrades()
		end
		return { Hint = "⬆️ Spend your cash on UPGRADES!", Target = nil }
	end

	local onShelves = 0
	for _, shelf in shelves do
		onShelves += shelf.Count
	end
	if stock == 0 and onShelves == 0 then
		return { Hint = "🚚 A delivery is coming — watch the loading bay!", Target = StoreQuery.part(StoreQuery.plot(), "LoadingBay") }
	end
	return { Hint = nil, Target = nil }
end

local function attachToCharacter(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root and root:IsA("BasePart") then
		local attachment = Instance.new("Attachment")
		attachment.Name = "GuideAttachment"
		attachment.Parent = root
		characterAttachment = attachment
		beam.Attachment0 = attachment
	end
end

local function update()
	local root = StoreQuery.rootPart()
	if not root then
		HUD.setHint(nil)
		marker.Enabled = false
		beam.Enabled = false
		return
	end
	local objective = currentObjective(root)
	HUD.setHint(objective.Hint)

	local target = objective.Target
	if target then
		local top = target.Position + Vector3.new(0, target.Size.Y / 2 + 1, 0)
		holder.CFrame = CFrame.new(top)
		local distance = (top - root.Position).Magnitude
		marker.Enabled = distance > 6
		local data = State.Data
		local learning = data == nil or data.ItemsSold < Config.GuideItemsSoldThreshold
		beam.Enabled = learning and distance > 10 and characterAttachment ~= nil
	else
		marker.Enabled = false
		beam.Enabled = false
	end
end

function Guide.init()
	holder = Instance.new("Part")
	holder.Name = "GuideTarget"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Parent = workspace

	targetAttachment = Instance.new("Attachment")
	targetAttachment.Parent = holder

	marker = Instance.new("BillboardGui")
	marker.Name = "GuideArrow"
	marker.Size = UDim2.fromScale(3, 3)
	marker.AlwaysOnTop = true
	marker.LightInfluence = 0
	marker.Enabled = false
	marker.Parent = holder
	local arrow = UIKit.label(marker, "⬇️")
	UIKit.textStroke(arrow, UIKit.Colors.Dark, 2)

	beam = Instance.new("Beam")
	beam.Attachment1 = targetAttachment
	beam.Color = ColorSequence.new(UIKit.Colors.Yellow, Color3.fromRGB(255, 255, 255))
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(0.5, 0.15),
		NumberSequenceKeypoint.new(1, 0.1),
	})
	beam.Width0 = 0.25
	beam.Width1 = 0.45
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Segments = 12
	beam.Enabled = false
	beam.Parent = holder

	if player.Character then
		task.spawn(attachToCharacter, player.Character)
	end
	player.CharacterAdded:Connect(attachToCharacter)

	-- Bounce the arrow.
	RunService.RenderStepped:Connect(function()
		marker.StudsOffsetWorldSpace = Vector3.new(0, 1.5 + math.abs(math.sin(os.clock() * 4)) * 1.2, 0)
	end)

	task.spawn(function()
		while true do
			local ok, err = pcall(function()
				update()
			end)
			if not ok then
				warn("[FillTheStore] Guide error: " .. tostring(err))
			end
			task.wait(0.2)
		end
	end)
end

return Guide
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!strict
-- Always-visible HUD: cash, delivery timer, UPGRADES / STOCK buttons and the
-- short objective hint at the bottom of the screen.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Signal = require(Shared:WaitForChild("Signal"))
local Upgrades = require(Shared:WaitForChild("Upgrades"))

local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Window = require(script.Parent.Window)

local Colors = UIKit.Colors
local player = Players.LocalPlayer

local HUD = {}

HUD.UpgradesPressed = Signal.new() :: Signal.Signal<>
HUD.StockPressed = Signal.new() :: Signal.Signal<>

local cashPill: Frame
local cashLabel: TextLabel
local deliveryLabel: TextLabel
local deliveryPill: Frame
local hintPill: Frame
local hintLabel: TextLabel
local stockBadge: Frame
local stockBadgeLabel: TextLabel
local upgradesAlert: Frame
local upgradesButton: TextButton

local displayedCash = 0
local targetCash = 0
local currentHint: string? = nil

local function bigButton(parent: Instance, icon: string, text: string, color: Color3, dark: Color3, onClick: () -> ()): TextButton
	local button = UIKit.button(parent, {
		Name = text,
		Size = UDim2.fromOffset(92, 92),
		BackgroundColor3 = color,
		Text = "",
	}, onClick)
	UIKit.stroke(button, dark, 4)
	UIKit.gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(215, 215, 215))
	UIKit.label(button, icon, { Size = UDim2.new(1, 0, 0.55, 0), Position = UDim2.fromScale(0, 0.06) })
	local label = UIKit.label(button, text, { Size = UDim2.new(0.9, 0, 0.26, 0), Position = UDim2.fromScale(0.05, 0.64) })
	UIKit.textStroke(label, dark, 2)
	return button
end

local function badge(parent: Instance, color: Color3): (Frame, TextLabel)
	local frame = UIKit.new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = color,
		Visible = false,
		ZIndex = 5,
	}, parent)
	UIKit.corner(frame, UDim.new(1, 0))
	UIKit.stroke(frame, Colors.White, 2)
	local label = UIKit.label(frame, "", { ZIndex = 6 })
	UIKit.padding(label, 4)
	return frame, label
end

function HUD.init(screen: ScreenGui)
	-- Cash (top centre)
	cashPill = UIKit.new("Frame", {
		Name = "Cash",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(260, 62),
		BackgroundColor3 = Colors.Dark,
		BackgroundTransparency = 0.1,
	}, screen)
	UIKit.corner(cashPill, UDim.new(1, 0))
	UIKit.stroke(cashPill, Colors.Gold, 3)
	local coin = UIKit.new("Frame", {
		Size = UDim2.fromOffset(50, 50),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Colors.Gold,
	}, cashPill)
	UIKit.corner(coin, UDim.new(1, 0))
	UIKit.stroke(coin, Color3.fromRGB(255, 240, 170), 3)
	UIKit.label(coin, "£", { TextColor3 = Color3.fromRGB(140, 90, 0), Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1) })
	cashLabel = UIKit.label(cashPill, "£0", {
		Name = "Amount",
		Position = UDim2.fromOffset(64, 9),
		Size = UDim2.new(1, -80, 1, -18),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	UIKit.textStroke(cashLabel, Color3.fromRGB(80, 60, 0), 2)

	-- Delivery timer / boxes waiting
	deliveryPill = UIKit.new("Frame", {
		Name = "Delivery",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.fromOffset(250, 34),
		BackgroundColor3 = Colors.Dark,
		BackgroundTransparency = 0.25,
	}, screen)
	UIKit.corner(deliveryPill, UDim.new(1, 0))
	deliveryLabel = UIKit.label(deliveryPill, "🚚 Delivery on the way!", {
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
	})

	-- Big buttons on the left
	local column = UIKit.new("Frame", {
		Name = "Buttons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.45, 0),
		Size = UDim2.fromOffset(96, 210),
		BackgroundTransparency = 1,
	}, screen)
	UIKit.new("UIListLayout", {
		Padding = UDim.new(0, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	}, column)
	upgradesButton = bigButton(column, "⬆️", "UPGRADES", Colors.Green, Colors.GreenDark, function()
		HUD.UpgradesPressed:Fire()
	end)
	upgradesButton.LayoutOrder = 1
	local stockButton = bigButton(column, "📦", "STOCK", Colors.Blue, Colors.BlueDark, function()
		HUD.StockPressed:Fire()
	end)
	stockButton.LayoutOrder = 2
	stockBadge, stockBadgeLabel = badge(stockButton, Colors.Red)
	upgradesAlert = badge(upgradesButton, Colors.Yellow)
	local alertLabel = upgradesAlert:FindFirstChildOfClass("TextLabel")
	if alertLabel then
		alertLabel.Text = "!"
		alertLabel.TextColor3 = Colors.Dark
	end

	-- Objective hint (bottom centre)
	hintPill = UIKit.new("Frame", {
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(380, 50),
		BackgroundColor3 = Colors.Dark,
		BackgroundTransparency = 0.15,
		Visible = false,
	}, screen)
	UIKit.corner(hintPill, UDim.new(1, 0))
	UIKit.stroke(hintPill, Colors.Yellow, 3)
	hintLabel = UIKit.label(hintPill, "", { Size = UDim2.new(1, -28, 1, -12), Position = UDim2.fromOffset(14, 6) })

	State.Changed:Connect(function(data, previous)
		targetCash = data.Cash
		if previous == nil then
			displayedCash = data.Cash
		elseif data.Cash > previous.Cash then
			HUD.floatCash(data.Cash - previous.Cash)
		end
		HUD.refreshBadges()
	end)
	if State.Data then
		targetCash = State.Data.Cash
		displayedCash = targetCash
	end

	-- Smooth count-up for cash.
	RunService.RenderStepped:Connect(function(dt: number)
		if math.abs(targetCash - displayedCash) < 0.5 then
			displayedCash = targetCash
		else
			displayedCash += (targetCash - displayedCash) * math.min(1, dt * 9)
		end
		cashLabel.Text = Format.money(math.floor(displayedCash + 0.5))
	end)

	-- Delivery pill refresh.
	task.spawn(function()
		while true do
			HUD.refreshDelivery()
			task.wait(0.25)
		end
	end)
end

function HUD.refreshDelivery()
	-- Menus get the screen to themselves (matters on phones).
	local menuOpen = Window.isAnyOpen()
	deliveryPill.Visible = not menuOpen
	hintPill.Visible = currentHint ~= nil and not menuOpen
	local waiting = 0
	for _, box in CollectionService:GetTagged("DeliveryBox") do
		local root = box:FindFirstChild("Box")
		if box:GetAttribute("OwnerUserId") == player.UserId and root and root:FindFirstChild("BoxPrompt") then
			waiting += 1
		end
	end
	if waiting > 0 then
		deliveryLabel.Text = `📦 {waiting} box{if waiting == 1 then "" else "es"} waiting!`
		deliveryLabel.TextColor3 = Colors.Yellow
		return
	end
	deliveryLabel.TextColor3 = Colors.White
	local nextAt = player:GetAttribute("NextDeliveryAt")
	if type(nextAt) == "number" then
		local remaining = math.max(0, math.ceil(nextAt - workspace:GetServerTimeNow()))
		deliveryLabel.Text = if remaining > 0 then `🚚 Next delivery {remaining}s` else "🚚 Delivery arriving!"
	else
		deliveryLabel.Text = "🚚 Delivery on the way!"
	end
end

function HUD.refreshBadges()
	local total = State.inventoryTotal()
	stockBadge.Visible = total > 0
	stockBadgeLabel.Text = if total > 999 then "999+" else tostring(total)

	local data = State.Data
	local affordable = false
	if data then
		for id, def in Upgrades.Defs do
			local cost = Upgrades.getCost(id, data.Upgrades[id] or def.StartLevel)
			if cost and cost <= data.Cash then
				affordable = true
				break
			end
		end
	end
	if affordable and not upgradesAlert.Visible then
		UIKit.pop(upgradesButton, 0.2)
	end
	upgradesAlert.Visible = affordable
end

-- "+£24" flying up next to the cash counter.
function HUD.floatCash(amount: number)
	UIKit.pop(cashPill, 0.08)
	local label = UIKit.label(cashPill.Parent, "+" .. Format.money(amount), {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.5, 136, 0, 38),
		Size = UDim2.fromOffset(160, 34),
		TextColor3 = Colors.Green,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 10,
	})
	UIKit.textStroke(label, Colors.Dark, 2)
	UIKit.tween(label, 0.9, { Position = UDim2.new(0.5, 136, 0, 4), TextTransparency = 1 })
	task.delay(0.95, function()
		label:Destroy()
	end)
end

function HUD.setHint(text: string?)
	if text == currentHint then
		return
	end
	currentHint = text
	if text then
		hintLabel.Text = text
		hintPill.Visible = not Window.isAnyOpen()
		UIKit.pop(hintPill, 0.12)
	else
		hintPill.Visible = false
	end
end

function HUD.pulseUpgrades()
	UIKit.pop(upgradesButton, 0.15)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--!strict
-- Banner notifications ("🚚 DELIVERY ARRIVED!", "✨ RAINBOW COLA!") and the
-- "DELIVERY OPENED!" card.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared:WaitForChild("Items"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local SoundPlayer = require(script.Parent.SoundPlayer)
local UIKit = require(script.Parent.UIKit)

local Colors = UIKit.Colors

local Notifications = {}

local container: Frame
local cardHolder: Frame
local activeCard: Frame? = nil

local STYLES: { [string]: { Color: Color3, Dark: Color3, Duration: number, Sound: string? } } = {
	Delivery = { Color = Colors.Orange, Dark = Color3.fromRGB(170, 80, 0), Duration = 2.6, Sound = "Delivery" },
	Rare = { Color = Colors.Purple, Dark = Color3.fromRGB(70, 30, 140), Duration = 3.5, Sound = "Rare" },
	Upgrade = { Color = Colors.Green, Dark = Colors.GreenDark, Duration = 2.2, Sound = nil },
	Expand = { Color = Colors.Pink, Dark = Color3.fromRGB(150, 30, 90), Duration = 3.5, Sound = "Upgrade" },
	Info = { Color = Colors.Panel, Dark = Colors.Dark, Duration = 2.6, Sound = nil },
	Error = { Color = Colors.Red, Dark = Color3.fromRGB(140, 30, 30), Duration = 2.2, Sound = "Error" },
}

function Notifications.init(screen: ScreenGui)
	container = UIKit.new("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 118),
		Size = UDim2.fromOffset(460, 260),
		BackgroundTransparency = 1,
	}, screen)
	UIKit.new("UIListLayout", {
		Padding = UDim.new(0, 8),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, container)

	cardHolder = UIKit.new("Frame", {
		Name = "BoxCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(330, 200),
		BackgroundTransparency = 1,
	}, screen)

	Remotes.event("Notify").OnClientEvent:Connect(function(kind: string, text: string)
		Notifications.show(kind, text)
	end)
end

local order = 0

function Notifications.show(kind: string, text: string)
	local style = STYLES[kind] or STYLES.Info
	order += 1
	local banner = UIKit.new("Frame", {
		Name = "Banner",
		Size = UDim2.fromOffset(if kind == "Rare" or kind == "Expand" then 440 else 400, if kind == "Info" then 44 else 54),
		BackgroundColor3 = style.Color,
		LayoutOrder = order,
	}, nil)
	UIKit.corner(banner, UDim.new(1, 0))
	UIKit.stroke(banner, style.Dark, 3)
	local label = UIKit.label(banner, text, { Size = UDim2.new(1, -30, 1, -12), Position = UDim2.fromOffset(15, 6) })
	UIKit.textStroke(label, style.Dark, 2)

	if kind == "Rare" then
		banner.BackgroundColor3 = Colors.White
		local gradient = UIKit.new("UIGradient", { Color = UIKit.rainbow() }, banner)
		local connection
		connection = RunService.RenderStepped:Connect(function()
			if not banner.Parent then
				connection:Disconnect()
				return
			end
			gradient.Offset = Vector2.new((os.clock() * 0.6) % 2 - 1, 0)
		end)
	end

	banner.Parent = container
	-- Keep at most 4 banners on screen.
	local banners = {}
	for _, child in container:GetChildren() do
		if child:IsA("Frame") then
			table.insert(banners, child)
		end
	end
	table.sort(banners, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #banners > 4 do
		local oldest = table.remove(banners, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local scale = UIKit.scaleOf(banner)
	scale.Scale = 0.3
	UIKit.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	if style.Sound then
		SoundPlayer.play(style.Sound)
	end
	task.delay(style.Duration, function()
		if banner.Parent then
			UIKit.tween(scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.wait(0.26)
			banner:Destroy()
		end
	end)
end

-- "DELIVERY OPENED!  🥤 Cola x10"
function Notifications.boxOpened(contents: { { Key: string, Count: number } })
	if activeCard then
		activeCard:Destroy()
	end
	local rows = math.min(#contents, 4)
	local card = UIKit.new("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(320, 64 + rows * 40),
		BackgroundColor3 = Colors.Dark,
		BackgroundTransparency = 0.05,
	}, nil)
	UIKit.corner(card, UDim.new(0, 20))
	UIKit.stroke(card, Colors.Yellow, 4)
	local title = UIKit.label(card, "DELIVERY OPENED!", {
		Size = UDim2.new(1, -24, 0, 36),
		Position = UDim2.fromOffset(12, 10),
		TextColor3 = Colors.Yellow,
	})
	UIKit.textStroke(title, Color3.fromRGB(120, 80, 0), 2)
	for index = 1, rows do
		local entry = contents[index]
		local rare = Items.isRare(entry.Key)
		local variant = Items.variant(entry.Key)
		local row = UIKit.label(card, `{Items.icon(entry.Key)} {Items.displayName(entry.Key)} x{entry.Count}`, {
			Size = UDim2.new(1, -24, 0, 34),
			Position = UDim2.fromOffset(12, 50 + (index - 1) * 40),
			TextColor3 = if rare then variant.Color else Colors.White,
		})
		if rare then
			UIKit.textStroke(row, Colors.Dark, 2)
		end
	end
	card.Parent = cardHolder
	activeCard = card
	local scale = UIKit.scaleOf(card)
	scale.Scale = 0.2
	UIKit.tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.8, function()
		if card.Parent then
			UIKit.tween(scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.wait(0.26)
			card:Destroy()
			if activeCard == card then
				activeCard = nil
			end
		end
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[--!strict
-- ProximityPrompts on stores are only shown to their owner, and only when
-- they can actually be used (e.g. "Stock Shelf" needs stock and free space,
-- "Open Box" needs you to be inside your shop). The server re-checks everything.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local State = require(script.Parent.State)
local StoreQuery = require(script.Parent.StoreQuery)

local player = Players.LocalPlayer

local Prompts = {}

local TAG = "OwnedPrompt"
local owned: { [ProximityPrompt]: boolean } = {}

local function register(instance: Instance)
	if not instance:IsA("ProximityPrompt") then
		return
	end
	if instance:GetAttribute("OwnerUserId") ~= player.UserId then
		instance.Enabled = false
		return
	end
	owned[instance] = true
end

local function shouldEnable(prompt: ProximityPrompt, carrying: boolean, stock: number, inside: boolean): boolean
	local kind = prompt:GetAttribute("Kind")
	if kind == "Shelf" then
		local shelf = prompt:FindFirstAncestorOfClass("Model")
		local count = shelf and shelf:GetAttribute("Count")
		local capacity = shelf and shelf:GetAttribute("Capacity")
		local hasSpace = type(count) == "number" and type(capacity) == "number" and count < capacity
		return not carrying and stock > 0 and hasSpace
	elseif kind == "Box" then
		return not carrying
	elseif kind == "OpenBox" then
		return inside
	end
	return true
end

function Prompts.update()
	local carrying = player:GetAttribute("CarryingBox") == true
	local stock = State.inventoryTotal()
	local root = StoreQuery.rootPart()
	local inside = root ~= nil and StoreQuery.isInside(root.Position)
	for prompt in owned do
		if not prompt:IsDescendantOf(workspace) then
			owned[prompt] = nil
		else
			local enabled = shouldEnable(prompt, carrying, stock, inside)
			if prompt.Enabled ~= enabled then
				prompt.Enabled = enabled
			end
		end
	end
end

function Prompts.init()
	for _, prompt in CollectionService:GetTagged(TAG) do
		register(prompt)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(register)
	task.spawn(function()
		while true do
			Prompts.update()
			task.wait(0.12)
		end
	end)
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">SoundPlayer</string>
              <string name="Source"><![CDATA[--!strict
-- Plays the sound effects defined in Shared/Sounds, optionally at a 3D position.

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local SoundPlayer = {}

local templates: { [string]: Sound } = {}
local lastPlayed: { [string]: number } = {}
local failed: { [string]: boolean } = {}

-- Preload every sound once; anything that fails switches to its fallback.
function SoundPlayer.init()
	task.spawn(function()
		local ids: { string } = {}
		for _, def in Sounds do
			if not table.find(ids, def.Id) then
				table.insert(ids, def.Id)
			end
		end
		pcall(function()
			ContentProvider:PreloadAsync(ids, function(contentId: string, status: Enum.AssetFetchStatus)
				if status ~= Enum.AssetFetchStatus.Success then
					failed[contentId] = true
				end
			end)
		end)
	end)
end

local function soundId(def: Sounds.SoundDef): string
	if failed[def.Id] and def.Fallback then
		return def.Fallback
	end
	return def.Id
end

local function template(name: string): Sound?
	local existing = templates[name]
	if existing then
		return existing
	end
	local def = Sounds[name]
	if not def then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = "SFX_" .. name
	sound.SoundId = soundId(def)
	sound.Volume = def.Volume
	sound.PlaybackSpeed = def.Speed
	sound.Parent = SoundService
	templates[name] = sound
	return sound
end

-- `pitch` multiplies the sound's speed. `position` makes it a 3D sound.
function SoundPlayer.play(name: string, pitch: number?, position: Vector3?, minGap: number?)
	local now = os.clock()
	if minGap and now - (lastPlayed[name] or 0) < minGap then
		return
	end
	lastPlayed[name] = now
	local base = template(name)
	if not base then
		return
	end
	local def = Sounds[name]
	if base.SoundId ~= soundId(def) then
		base.SoundId = soundId(def)
	end
	local sound = base:Clone()
	sound.PlaybackSpeed = base.PlaybackSpeed * (pitch or 1)
	if position then
		local holder = Instance.new("Part")
		holder.Name = "SoundHolder"
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.Transparency = 1
		holder.Size = Vector3.new(0.2, 0.2, 0.2)
		holder.Position = position
		holder.Parent = workspace
		sound.RollOffMaxDistance = 90
		sound.RollOffMinDistance = 12
		sound.Parent = holder
		sound:Play()
		Debris:AddItem(holder, 4)
	else
		sound.Parent = SoundService
		sound:Play()
		Debris:AddItem(sound, 4)
	end
end

return SoundPlayer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side copy of the player's data (read-only; the server is authoritative).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Signal = require(Shared:WaitForChild("Signal"))

export type Snapshot = {
	Cash: number,
	TotalEarned: number,
	Upgrades: { [string]: number },
	Inventory: { [string]: number },
	SelectedProduct: string?,
	StoreValue: number,
	ItemsSold: number,
	Saving: boolean,
}

local State = {}

State.Data = nil :: Snapshot?
State.Changed = Signal.new() :: Signal.Signal<Snapshot, Snapshot?>

local function apply(snapshot: any)
	if type(snapshot) ~= "table" then
		return
	end
	local previous = State.Data
	State.Data = snapshot
	State.Changed:Fire(snapshot, previous)
end

function State.init()
	Remotes.event("DataUpdate").OnClientEvent:Connect(apply)
	task.spawn(function()
		-- The server may still be loading our save; keep asking until it answers.
		for _ = 1, 20 do
			if State.Data then
				return
			end
			local ok, snapshot = pcall(function()
				return Remotes.func("GetData"):InvokeServer()
			end)
			if ok and snapshot then
				if not State.Data then
					apply(snapshot)
				end
				return
			end
			task.wait(1)
		end
	end)
end

function State.inventoryTotal(): number
	local data = State.Data
	if not data then
		return 0
	end
	local total = 0
	for _, count in data.Inventory do
		total += count
	end
	return total
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">StockPanel</string>
              <string name="Source"><![CDATA[--!strict
-- PRODUCTS / STOCK menu: what's in the stock room. Tapping a product makes
-- it the first thing put on shelves.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Items = require(Shared:WaitForChild("Items"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Products = require(Shared:WaitForChild("Products"))

local SoundPlayer = require(script.Parent.SoundPlayer)
local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Window = require(script.Parent.Window)

local Colors = UIKit.Colors

local StockPanel = {}

local window: Window.Window
local grid: ScrollingFrame
local emptyLabel: TextLabel

local VARIANT_BACKGROUNDS: { [string]: Color3 } = {
	Normal = Color3.fromRGB(58, 62, 90),
	Golden = Color3.fromRGB(255, 196, 37),
	Rainbow = Color3.fromRGB(255, 255, 255),
	Giant = Color3.fromRGB(60, 200, 140),
}

local function select(productId: string)
	local data = State.Data
	local current = data and data.SelectedProduct
	Remotes.event("SelectProduct"):FireServer(if current == productId then nil else productId)
	SoundPlayer.play("Click")
end

local function tile(key: string, count: number, selected: boolean, order: number)
	local product = Items.product(key)
	local variant = Items.variant(key)
	local button = UIKit.button(grid, {
		Name = key,
		BackgroundColor3 = VARIANT_BACKGROUNDS[variant.Id] or VARIANT_BACKGROUNDS.Normal,
		Text = "",
		LayoutOrder = order,
		ZIndex = 22,
	}, function()
		select(product.Id)
	end)
	if variant.Id == "Rainbow" then
		UIKit.new("UIGradient", { Color = UIKit.rainbow(), Rotation = 45 }, button)
	end
	local rarityColor = Products.Rarities[product.Rarity].Color
	UIKit.stroke(button, if selected then Colors.Yellow else rarityColor, if selected then 5 else 3)
	UIKit.label(button, product.Icon, { Size = UDim2.new(1, 0, 0.46, 0), Position = UDim2.fromScale(0, 0.06), ZIndex = 23 })
	local name = UIKit.label(button, Items.displayName(key), {
		Size = UDim2.new(0.92, 0, 0.18, 0),
		Position = UDim2.fromScale(0.04, 0.54),
		ZIndex = 23,
	})
	UIKit.textStroke(name, Colors.Dark, 2)
	local amount = UIKit.label(button, "x" .. count, {
		Size = UDim2.new(0.9, 0, 0.2, 0),
		Position = UDim2.fromScale(0.05, 0.75),
		TextColor3 = Colors.Yellow,
		ZIndex = 23,
	})
	UIKit.textStroke(amount, Colors.Dark, 2)
	if selected then
		UIKit.label(button, "⭐", {
			Size = UDim2.fromOffset(26, 26),
			Position = UDim2.fromOffset(4, 4),
			ZIndex = 24,
		})
	end
end

local function refresh()
	local data = State.Data
	if not data then
		return
	end
	for _, child in grid:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local keys = {}
	local total = 0
	local value = 0
	for key, count in data.Inventory do
		if Items.isValid(key) and count > 0 then
			table.insert(keys, key)
			total += count
			value += Items.sellPrice(key) * count
		end
	end
	table.sort(keys, Items.compare)
	for order, key in keys do
		local productId = Items.product(key).Id
		tile(key, data.Inventory[key], productId == data.SelectedProduct, order)
	end
	emptyLabel.Visible = #keys == 0
	window.Subtitle.Text = if #keys == 0
		then "Your stock room is empty"
		else `{total} items · worth {Format.money(value)} · tap one to stock it first`
end

function StockPanel.init(screen: ScreenGui)
	window = Window.new(screen, "📦 STOCK", Colors.Blue, Colors.BlueDark)
	grid = UIKit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Colors.Grey,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 22,
	}, window.Content)
	UIKit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(118, 122),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	UIKit.padding(grid, 6)
	emptyLabel = UIKit.label(window.Content, "No stock yet!\n📦 Grab a delivery box and open it inside your shop.", {
		Size = UDim2.new(1, -40, 0, 90),
		Position = UDim2.fromOffset(20, 60),
		TextColor3 = Color3.fromRGB(200, 205, 225),
		ZIndex = 23,
		Visible = false,
	})
	window.OnOpen = refresh
	State.Changed:Connect(function()
		if window:IsOpen() then
			refresh()
		end
	end)
end

function StockPanel.toggle()
	Window.toggle(window)
end

return StockPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">StoreQuery</string>
              <string name="Source"><![CDATA[--!strict
-- Read-only helpers for finding things in the local player's own store.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

local StoreQuery = {}

function StoreQuery.plot(): Model?
	local index = player:GetAttribute("PlotIndex")
	local world = workspace:FindFirstChild("World")
	local plots = world and world:FindFirstChild("Plots")
	local plot = plots and index and plots:FindFirstChild("Plot" .. tostring(index))
	if plot and plot:IsA("Model") then
		return plot
	end
	return nil
end

function StoreQuery.store(): Model?
	local plot = StoreQuery.plot()
	local store = plot and plot:FindFirstChild("Store")
	if store and store:IsA("Model") then
		return store
	end
	return nil
end

function StoreQuery.part(parent: Instance?, name: string): BasePart?
	local part = parent and parent:FindFirstChild(name)
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

-- Slightly stricter than the server check so a visible prompt always works.
function StoreQuery.isInside(position: Vector3): boolean
	local interior = StoreQuery.part(StoreQuery.store(), "Interior")
	if not interior then
		return false
	end
	local relative = interior.CFrame:PointToObjectSpace(position)
	local size = interior.Size
	return math.abs(relative.X) <= size.X / 2 + 1.5
		and math.abs(relative.Z) <= size.Z / 2 + 1.5
		and math.abs(relative.Y) <= size.Y
end

function StoreQuery.rootPart(): BasePart?
	local character = player.Character
	return StoreQuery.part(character, "HumanoidRootPart")
end

-- Own shelves with their fill state.
function StoreQuery.shelves(): { { Model: Model, Count: number, Capacity: number, Target: BasePart? } }
	local result = {}
	for _, shelf in CollectionService:GetTagged("Shelf") do
		if shelf:IsA("Model") and shelf:GetAttribute("OwnerUserId") == player.UserId then
			local count = shelf:GetAttribute("Count")
			local capacity = shelf:GetAttribute("Capacity")
			table.insert(result, {
				Model = shelf,
				Count = if type(count) == "number" then count else 0,
				Capacity = if type(capacity) == "number" then capacity else 0,
				Target = StoreQuery.part(shelf, "Base"),
			})
		end
	end
	return result
end

-- Own boxes that have landed on the loading bay and can be picked up.
function StoreQuery.boxesOnPad(): { BasePart }
	local result = {}
	for _, box in CollectionService:GetTagged("DeliveryBox") do
		local root = StoreQuery.part(box, "Box")
		if box:GetAttribute("OwnerUserId") == player.UserId and root and root:FindFirstChild("BoxPrompt") then
			table.insert(result, root)
		end
	end
	return result
end

return StoreQuery
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny helpers for building the rounded, colourful UI in code.

local TweenService = game:GetService("TweenService")

local UIKit = {}

UIKit.Font = Enum.Font.FredokaOne

UIKit.Colors = {
	Dark = Color3.fromRGB(26, 28, 42),
	Panel = Color3.fromRGB(38, 41, 60),
	PanelLight = Color3.fromRGB(54, 58, 84),
	White = Color3.fromRGB(255, 255, 255),
	Green = Color3.fromRGB(70, 210, 90),
	GreenDark = Color3.fromRGB(35, 140, 60),
	Blue = Color3.fromRGB(60, 150, 255),
	BlueDark = Color3.fromRGB(30, 90, 200),
	Yellow = Color3.fromRGB(255, 205, 50),
	Orange = Color3.fromRGB(255, 150, 40),
	Red = Color3.fromRGB(255, 80, 80),
	Pink = Color3.fromRGB(255, 90, 170),
	Purple = Color3.fromRGB(150, 90, 255),
	Grey = Color3.fromRGB(120, 124, 140),
	Gold = Color3.fromRGB(255, 196, 37),
}

-- Create an instance, set properties, parent it last.
function UIKit.new(className: string, props: { [string]: any }?, parent: Instance?): any
	local instance = Instance.new(className :: any)
	if props then
		for key, value in props do
			(instance :: any)[key] = value
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIKit.corner(parent: Instance, radius: UDim?): UICorner
	return UIKit.new("UICorner", { CornerRadius = radius or UDim.new(0, 14) }, parent)
end

function UIKit.stroke(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	return UIKit.new("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function UIKit.textStroke(parent: Instance, color: Color3, thickness: number): UIStroke
	return UIKit.new("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}, parent)
end

function UIKit.padding(parent: Instance, pixels: number): UIPadding
	local p = UDim.new(0, pixels)
	return UIKit.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p }, parent)
end

function UIKit.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	}, parent)
end

function UIKit.rainbow(): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
		ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 190, 60)),
		ColorSequenceKeypoint.new(0.4, Color3.fromRGB(110, 230, 90)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 190, 255)),
		ColorSequenceKeypoint.new(0.8, Color3.fromRGB(160, 100, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 190)),
	})
end

function UIKit.label(parent: Instance?, text: string, props: { [string]: any }?): TextLabel
	local label = UIKit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		Text = text,
		TextColor3 = UIKit.Colors.White,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
	}, nil)
	if props then
		for key, value in props do
			(label :: any)[key] = value
		end
	end
	label.Parent = parent
	return label
end

function UIKit.tween(instance: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Every GuiObject that wants pop/press animations gets a UIScale.
function UIKit.scaleOf(object: GuiObject): UIScale
	local existing = object:FindFirstChild("PopScale")
	if existing and existing:IsA("UIScale") then
		return existing
	end
	return UIKit.new("UIScale", { Name = "PopScale" }, object)
end

-- Quick "boing" pop.
function UIKit.pop(object: GuiObject, amount: number?)
	local scale = UIKit.scaleOf(object)
	scale.Scale = 1 + (amount or 0.15)
	UIKit.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

-- Horizontal shake for "can't afford" feedback.
function UIKit.shake(object: GuiObject)
	local origin = object.Position
	task.spawn(function()
		for _, dx in { -8, 8, -6, 6, -3, 0 } do
			object.Position = origin + UDim2.fromOffset(dx, 0)
			task.wait(0.03)
		end
		object.Position = origin
	end)
end

-- Chunky button with a press animation.
function UIKit.button(parent: Instance, props: { [string]: any }, onClick: () -> ()): TextButton
	local button = UIKit.new("TextButton", {
		AutoButtonColor = false,
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.White,
		TextScaled = true,
		BorderSizePixel = 0,
	}, nil)
	for key, value in props do
		(button :: any)[key] = value
	end
	UIKit.corner(button)
	local scale = UIKit.scaleOf(button)
	button.MouseButton1Down:Connect(function()
		UIKit.tween(scale, 0.08, { Scale = 0.92 })
	end)
	button.MouseButton1Up:Connect(function()
		UIKit.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		UIKit.tween(scale, 0.2, { Scale = 1 })
	end)
	button.Activated:Connect(onClick)
	button.Parent = parent
	return button
end

return UIKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">UpgradesPanel</string>
              <string name="Source"><![CDATA[--!strict
-- The single upgrade menu. Purchases are validated by the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Upgrades = require(Shared:WaitForChild("Upgrades"))

local SoundPlayer = require(script.Parent.SoundPlayer)
local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Window = require(script.Parent.Window)

local Colors = UIKit.Colors

local UpgradesPanel = {}

type Row = {
	Frame: Frame,
	Level: TextLabel,
	Effect: TextLabel,
	Buy: TextButton,
	BuyStroke: UIStroke,
}

local window: Window.Window
local rows: { [string]: Row } = {}
local buying = false

local function refresh()
	local data = State.Data
	if not data then
		return
	end
	for id, row in rows do
		local def = Upgrades.Defs[id]
		local level = data.Upgrades[id] or def.StartLevel
		local cost = Upgrades.getCost(id, level)
		local shownLevel = level - def.StartLevel
		local maxShown = def.MaxLevel - def.StartLevel
		row.Level.Text = `Lv {shownLevel}/{maxShown}`
		if cost then
			row.Effect.Text = `{def.Effect(level)}  →  {def.Effect(level + 1)}`
			row.Buy.Text = Format.money(cost)
			local affordable = data.Cash >= cost
			row.Buy.BackgroundColor3 = if affordable then Colors.Green else Colors.Grey
			row.BuyStroke.Color = if affordable then Colors.GreenDark else Color3.fromRGB(80, 84, 100)
		else
			row.Effect.Text = def.Effect(level)
			row.Buy.Text = "MAX"
			row.Buy.BackgroundColor3 = Colors.Gold
			row.BuyStroke.Color = Color3.fromRGB(160, 110, 0)
		end
	end
	window.Subtitle.Text = `💷 You have {Format.money(data.Cash)}`
end

local function buy(id: string, row: Row)
	if buying then
		return
	end
	buying = true
	local ok, success, message = pcall(function()
		return Remotes.func("BuyUpgrade"):InvokeServer(id)
	end)
	buying = false
	if ok and success then
		SoundPlayer.play("Upgrade")
		SoundPlayer.play("Cash", 1.2)
		UIKit.pop(row.Frame, 0.08)
		local flash = UIKit.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Colors.White,
			BackgroundTransparency = 0.3,
			ZIndex = 30,
		}, row.Frame)
		UIKit.corner(flash, UDim.new(0, 16))
		UIKit.tween(flash, 0.4, { BackgroundTransparency = 1 })
		task.delay(0.45, function()
			flash:Destroy()
		end)
	else
		SoundPlayer.play("Error")
		UIKit.shake(row.Buy)
		if ok and type(message) == "string" then
			window.Subtitle.Text = "⚠️ " .. message
		end
	end
end

local function makeRow(parent: Instance, id: string, order: number): Row
	local def = Upgrades.Defs[id]
	local frame = UIKit.new("Frame", {
		Name = id,
		Size = UDim2.new(1, -10, 0, 82),
		BackgroundColor3 = Colors.PanelLight,
		LayoutOrder = order,
		ZIndex = 22,
	}, parent)
	UIKit.corner(frame, UDim.new(0, 16))

	local icon = UIKit.new("Frame", {
		Size = UDim2.fromOffset(62, 62),
		Position = UDim2.fromOffset(10, 10),
		BackgroundColor3 = def.Color,
		ZIndex = 23,
	}, frame)
	UIKit.corner(icon, UDim.new(0, 14))
	UIKit.stroke(icon, def.Color:Lerp(Color3.new(0, 0, 0), 0.35), 3)
	UIKit.label(icon, def.Icon, { Size = UDim2.fromScale(0.75, 0.75), Position = UDim2.fromScale(0.125, 0.125), ZIndex = 24 })

	local name = UIKit.label(frame, def.Name, {
		Size = UDim2.new(1, -250, 0, 28),
		Position = UDim2.fromOffset(84, 8),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 23,
	})
	UIKit.textStroke(name, Colors.Dark, 2)
	local level = UIKit.label(frame, "Lv 0", {
		AnchorPoint = Vector2.new(1, 0),
		Size = UDim2.fromOffset(70, 22),
		Position = UDim2.new(1, -150, 0, 11),
		TextColor3 = Colors.Yellow,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 23,
	})
	local effect = UIKit.label(frame, def.Description, {
		Size = UDim2.new(1, -240, 0, 22),
		Position = UDim2.fromOffset(84, 38),
		TextColor3 = Color3.fromRGB(210, 215, 235),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 23,
	})
	UIKit.label(frame, def.Description, {
		Size = UDim2.new(1, -240, 0, 16),
		Position = UDim2.fromOffset(84, 60),
		TextColor3 = Color3.fromRGB(150, 155, 180),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 23,
	})

	local row: Row
	local buyButton = UIKit.button(frame, {
		Name = "Buy",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(130, 56),
		BackgroundColor3 = Colors.Green,
		Text = "",
		ZIndex = 23,
	}, function()
		buy(id, row)
	end)
	UIKit.padding(buyButton, 10)
	UIKit.new("UITextSizeConstraint", { MaxTextSize = 30 }, buyButton)
	row = {
		Frame = frame,
		Level = level,
		Effect = effect,
		Buy = buyButton,
		BuyStroke = UIKit.stroke(buyButton, Colors.GreenDark, 3),
	}
	return row
end

function UpgradesPanel.init(screen: ScreenGui)
	window = Window.new(screen, "⬆️ UPGRADES", Colors.Green, Colors.GreenDark)
	local list = UIKit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Colors.Grey,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 22,
	}, window.Content)
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	for order, id in Upgrades.Order do
		rows[id] = makeRow(list, id, order)
	end
	window.OnOpen = refresh
	State.Changed:Connect(function()
		if window:IsOpen() then
			refresh()
		end
	end)
end

function UpgradesPanel.toggle()
	Window.toggle(window)
end

return UpgradesPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Window</string>
              <string name="Source"><![CDATA[--!strict
-- Shared pop-up window frame used by the Upgrades and Stock menus.
-- Only one window is open at a time.

local UIKit = require(script.Parent.UIKit)
local SoundPlayer = require(script.Parent.SoundPlayer)

local Colors = UIKit.Colors

export type Window = {
	Frame: Frame,
	Content: Frame,
	Subtitle: TextLabel,
	Open: (self: Window) -> (),
	Close: (self: Window) -> (),
	IsOpen: (self: Window) -> boolean,
	OnOpen: (() -> ())?,
}

local Window = {}

local openWindow: Window? = nil

function Window.new(screen: ScreenGui, title: string, color: Color3, dark: Color3): Window
	local frame = UIKit.new("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(560, 440),
		BackgroundColor3 = Colors.Panel,
		Visible = false,
		ZIndex = 20,
	}, screen)
	UIKit.corner(frame, UDim.new(0, 24))
	UIKit.stroke(frame, dark, 5)
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(560, 440) }, frame)

	local header = UIKit.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = color,
		ZIndex = 21,
	}, frame)
	UIKit.corner(header, UDim.new(0, 24))
	-- Square off the header's bottom corners.
	UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 1, -24),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 21,
	}, header)
	local titleLabel = UIKit.label(header, title, {
		Size = UDim2.new(1, -120, 0, 44),
		Position = UDim2.fromOffset(20, 10),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
	})
	UIKit.textStroke(titleLabel, dark, 3)

	local subtitle = UIKit.label(frame, "", {
		Name = "Subtitle",
		Size = UDim2.new(1, -40, 0, 26),
		Position = UDim2.fromOffset(20, 72),
		TextColor3 = Color3.fromRGB(200, 205, 225),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 21,
	})

	local content = UIKit.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -28, 1, -118),
		Position = UDim2.fromOffset(14, 104),
		BackgroundTransparency = 1,
		ZIndex = 21,
	}, frame)

	local self: Window
	self = {
		Frame = frame,
		Content = content,
		Subtitle = subtitle,
		OnOpen = nil,
		Open = function(window: Window)
			if openWindow and openWindow ~= window then
				openWindow:Close()
			end
			openWindow = window
			frame.Visible = true
			local scale = UIKit.scaleOf(frame)
			scale.Scale = 0.6
			UIKit.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			SoundPlayer.play("Click")
			if window.OnOpen then
				window.OnOpen()
			end
		end,
		Close = function(window: Window)
			if openWindow == window then
				openWindow = nil
			end
			frame.Visible = false
		end,
		IsOpen = function(_window: Window): boolean
			return frame.Visible
		end,
	}

	local close = UIKit.button(header, {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = Colors.Red,
		Text = "✕",
		ZIndex = 23,
	}, function()
		SoundPlayer.play("Click")
		self:Close()
	end)
	UIKit.stroke(close, Color3.fromRGB(150, 30, 30), 3)
	UIKit.padding(close, 8)

	return self
end

function Window.isAnyOpen(): boolean
	return openWindow ~= nil
end

-- Toggle helper for HUD buttons.
function Window.toggle(window: Window)
	if window:IsOpen() then
		window:Close()
	else
		window:Open()
	end
end

return Window
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="59">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Fill the Store! — client entry point. Builds the UI and starts the
-- client-side controllers in ./Controllers.

local Players = game:GetService("Players")

local Controllers = script.Parent.Controllers
local Effects = require(Controllers.Effects)
local Guide = require(Controllers.Guide)
local HUD = require(Controllers.HUD)
local Notifications = require(Controllers.Notifications)
local Prompts = require(Controllers.Prompts)
local SoundPlayer = require(Controllers.SoundPlayer)
local State = require(Controllers.State)
local StockPanel = require(Controllers.StockPanel)
local UpgradesPanel = require(Controllers.UpgradesPanel)

local player = Players.LocalPlayer

local screen = Instance.new("ScreenGui")
screen.Name = "FillTheStoreUI"
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.IgnoreGuiInset = false

-- Scale the whole UI down on small (mobile) screens.
local uiScale = Instance.new("UIScale")
uiScale.Parent = screen
local function updateScale()
	local camera = workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		uiScale.Scale = math.clamp(math.min(size.X / 1150, size.Y / 720), 0.55, 1.15)
	end
end
updateScale()
local function watchCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		updateScale()
	end
end
watchCamera()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)

screen.Parent = player:WaitForChild("PlayerGui")

SoundPlayer.init()
State.init()
HUD.init(screen)
Notifications.init(screen)
UpgradesPanel.init(screen)
StockPanel.init(screen)
Effects.init()
Prompts.init()
Guide.init()

HUD.UpgradesPressed:Connect(UpgradesPanel.toggle)
HUD.StockPressed:Connect(StockPanel.toggle)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
