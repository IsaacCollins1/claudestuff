          <string name="Name">BoxVisual</string>
          <string name="Source"><![CDATA[--!strict
-- Cardboard delivery box. The server uses it for boxes on the loading bay and
-- being carried; the client builds one with flaps for the opening animation.
-- The tape colour hints at the rarity of what's inside.

local Build = require(script.Parent.Build)

local BoxVisual = {}

BoxVisual.Size = Vector3.new(2.6, 2.1, 2.6)
BoxVisual.Cardboard = Color3.fromRGB(205, 150, 95)

export type Box = {
	Model: Model,
	Root: BasePart,
	FlapLeft: BasePart?,
	FlapRight: BasePart?,
}

function BoxVisual.build(tapeColor: Color3, withFlaps: boolean?): Box
	local size = BoxVisual.Size
	local model = Instance.new("Model")
	model.Name = "DeliveryBox"
	local origin = CFrame.new()

	local root = Build.part(model, "Box", size, origin, BoxVisual.Cardboard)
	local darker = BoxVisual.Cardboard:Lerp(Color3.new(0, 0, 0), 0.12)

	-- Tape across the top and down the front/back, plus a "fragile" style label.
	Build.part(model, "TapeTop", Vector3.new(0.55, 0.06, size.Z + 0.02), origin * CFrame.new(0, size.Y / 2 + 0.02, 0), tapeColor)
	Build.part(model, "TapeFront", Vector3.new(0.55, 0.7, 0.06), origin * CFrame.new(0, size.Y / 2 - 0.35, -size.Z / 2 - 0.02), tapeColor)
	Build.part(model, "TapeBack", Vector3.new(0.55, 0.7, 0.06), origin * CFrame.new(0, size.Y / 2 - 0.35, size.Z / 2 + 0.02), tapeColor)
	Build.part(model, "Label", Vector3.new(0.9, 0.6, 0.05), origin * CFrame.new(0.7, -0.3, -size.Z / 2 - 0.02), Color3.fromRGB(250, 250, 245))
	Build.part(model, "Edge", Vector3.new(size.X + 0.04, 0.12, size.Z + 0.04), origin * CFrame.new(0, -size.Y / 2 + 0.06, 0), darker)

	local flapLeft: BasePart? = nil
	local flapRight: BasePart? = nil
	if withFlaps then
		-- Separate top flaps hinged on the left/right edges for the opening animation.
		local left = Build.part(model, "FlapLeft", Vector3.new(size.X / 2, 0.08, size.Z), origin * CFrame.new(-size.X / 4, size.Y / 2 + 0.04, 0), darker)
		local right = Build.part(model, "FlapRight", Vector3.new(size.X / 2, 0.08, size.Z), origin * CFrame.new(size.X / 4, size.Y / 2 + 0.04, 0), darker)
		flapLeft, flapRight = left, right
		local tape = model:FindFirstChild("TapeTop")
		if tape then
			tape:Destroy()
		end
	end

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CanCollide = descendant == root
			descendant.CanTouch = false
			descendant.CastShadow = true
		end
	end
	if not withFlaps then
		-- Welded so the server can carry/tween the whole box by its root.
		Build.weldAll(model, root)
	end
	-- (The client's flapped version stays fully anchored and is animated with PivotTo.)
	root.Anchored = true
	model.PrimaryPart = root
	return { Model = model, Root = root, FlapLeft = flapLeft, FlapRight = flapRight }
end

return BoxVisual
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[--!strict
-- Small helpers for building things out of plain Parts.
-- Used by the server (stores, trucks, NPCs) and the client (effects).

local Build = {}

Build.Font = Enum.Font.FredokaOne
Build.White = Color3.fromRGB(255, 255, 255)
Build.Dark = Color3.fromRGB(35, 38, 48)

function Build.part(
	parent: Instance?,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- Upright cylinder whose height runs along the Y axis of `cframe`.
function Build.cylinder(
	parent: Instance?,
	name: string,
	height: number,
	diameter: number,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part =
		Build.part(nil, name, Vector3.new(height, diameter, diameter), cframe * CFrame.Angles(0, 0, math.pi / 2), color, material)
	part.Shape = Enum.PartType.Cylinder
	part.Parent = parent
	return part
end

-- Cylinder lying along the X axis of `cframe` (wheels, rolls on their side...).
function Build.sideCylinder(
	parent: Instance?,
	name: string,
	length: number,
	diameter: number,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Build.part(nil, name, Vector3.new(length, diameter, diameter), cframe, color, material)
	part.Shape = Enum.PartType.Cylinder
	part.Parent = parent
	return part
end

function Build.ball(
	parent: Instance?,
	name: string,
	diameter: number,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Build.part(nil, name, Vector3.new(diameter, diameter, diameter), cframe, color, material)
	part.Shape = Enum.PartType.Ball
	part.Parent = parent
	return part
end

-- Purely visual: players and NPCs walk through it, raycasts ignore it.
function Build.decor(part: BasePart)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
end

-- Weld every BasePart in `model` to `root` so the whole thing moves when `root` moves.
function Build.weldAll(model: Instance, root: BasePart)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = descendant
			descendant.Anchored = false
		end
	end
end

function Build.textLabel(parent: Instance?, text: string, color: Color3?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Build.Font
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = color or Build.White
	label.Parent = parent
	return label
end

function Build.stroke(parent: Instance, color: Color3, thickness: number): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Parent = parent
	return stroke
end

function Build.corner(parent: Instance, radius: UDim?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or UDim.new(0, 12)
	corner.Parent = parent
	return corner
end

-- A SurfaceGui with one big line of text on a face of `part`.
function Build.surfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3?): (SurfaceGui, TextLabel)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text" .. face.Name
	gui.Face = face
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = part
	local label = Build.textLabel(gui, text, color)
	Build.stroke(label, Build.Dark, 3)
	return gui, label
end

function Build.billboard(parent: Instance, size: UDim2, offset: Vector3, maxDistance: number): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffsetWorldSpace = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Parent = parent
	return gui
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
